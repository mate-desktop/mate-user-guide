#. (itstool) path: entry/para
#: C/goscaja.xml:3625
#: C/goscaja.xml:3777
msgid "<guilabel>Date Accessed</guilabel>"
msgstr "<guilabel>ວັນທີເຂົ້າເຖິງ</guilabel>"

#. (itstool) path: entry/para
#: C/goscaja.xml:3630
#: C/goscaja.xml:3782

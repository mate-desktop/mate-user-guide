#: C/goscaja.xml:1684
msgid "<guimenuitem>Move here</guimenuitem>"
msgstr "<guimenuitem>ຍ້າຍມາທີ່ນີ້</guimenuitem>"

#. (itstool) path: listitem/para
#: C/goscaja.xml:1687
msgid "Moves the item to the location."
msgstr "ຍ້າຍລາຍການໄປທີ່ຕຳແໜ່ງນັ້ນ."

#. (itstool) path: listitem/para
#: C/goscaja.xml:1690
msgid "<guimenuitem>Copy here</guimenuitem>"
msgstr "<guimenuitem>ສຳເນົາມາທີ່ນີ້</guimenuitem>"

#. (itstool) path: listitem/para
#: C/goscaja.xml:1693
msgid "Copies the item to the location."
msgstr "ສຳເນົາລາຍການໄປທີ່ຕຳແໜ່ງນັ້ນ."

#. (itstool) path: listitem/para
#: C/goscaja.xml:1696
msgid "<guimenuitem>Link here</guimenuitem>"
msgstr "<guimenuitem>ສ້າງລິ້ງທີ່ນີ້</guimenuitem>"

#. (itstool) path: listitem/para
#: C/goscaja.xml:1699
msgid "Creates a symbolic link to the item at the location."
msgstr "ສ້າງລິ້ງສັນຍະລັກໄປຫາລາຍການທີ່ຕຳແໜ່ງນັ້ນ."

#. (itstool) path: listitem/para
#: C/goscaja.xml:1702
msgid "<guimenuitem>Set as Background</guimenuitem>"
msgstr "<guimenuitem>ຕັ້ງເປັນພື້ນຫຼັງ</guimenuitem>"

#. (itstool) path: listitem/para
#: C/goscaja.xml:1705
msgid "If the item is an image, sets the image to be the background. You can use this command to set the background of the desktop, the side pane or the view pane."
msgstr ""
"ຫາກລາຍການນັ້ນເປັນຮູບພາບ, ມັນຈະຕັ້ງຮູບນັ້ນເປັນພື້ນຫຼັງ. ເຈົ້າສາມາດໃຊ້ຄຳສັ່ງນີ້ເພື່ອຕັ້ງພື້ນຫຼັງຂອງເດັສທັອບ, ແຖ"
"ບຂ້າງ ຫຼື ສ່ວນສະແດງຜົນໄດ້."

#. (itstool) path: listitem/para
#: C/goscaja.xml:1709
msgid "<guimenuitem>Cancel</guimenuitem>"
msgstr "<guimenuitem>ຍົກເລີກ</guimenuitem>"

#. (itstool) path: listitem/para
#: C/goscaja.xml:1712
msgid "Cancels the drag-and-drop operation."
msgstr "ຍົກເລີກການລາກແລ້ວວາງ."

#. (itstool) path: screenshot/mediaobject
#: C/goscaja.xml:1718
msgid "<imageobject> <imagedata fileref=\"figures/ask_pointer.png\" format=\"PNG\"/> </imageobject> <textobject> <phrase>Ask pointer.</phrase> </textobject>"
msgstr ""
"<imageobject> <imagedata fileref=\"figures/ask_pointer.png\" "
"format=\"PNG\"/> </imageobject> <textobject> <phrase>ຕົວຊີ້ການຖາມ.</phrase> </"
"textobject>"

#. (itstool) path: info/title
#: C/goscaja.xml:1734
msgid "Moving a File or Folder"
msgstr "ການຍ້າຍໄຟລ໌ ຫຼື ໂຟນເດີ"

#. (itstool) path: section/indexterm
#: C/goscaja.xml:1735
msgid "<primary>file manager</primary> <secondary>moving files and folders</secondary>"
msgstr ""
"<primary>ຕົວຈັດການໄຟລ໌</primary> <secondary>ການຍ້າຍໄຟລ໌ ແລະ ໂຟນເດີ</secondary>"

#. (itstool) path: section/para
#: C/goscaja.xml:1739
msgid "You can move a file or folder by dragging it with the mouse, or with the cut and paste commands. The following sections describe these two methods."
msgstr ""
"ເຈົ້າສາມາດຍ້າຍໄຟລ໌ ຫຼື ໂຟນເດີໄດ້ໂດຍການລາກດ້ວຍເມົາສ໌ ຫຼື ໃຊ້ຄຳສັ່ງຕັດ (cut) ແລະ ວາງ (paste). ສ່ວ"
"ນຕ່າງໆຕໍ່ໄປນີ້ຈະອະທິບາຍທັງສອງວິທີນັ້ນ."

#. (itstool) path: info/title
#: C/goscaja.xml:1741
#: C/goscaja.xml:1783
msgid "Drag to the New Location"
msgstr "ລາກໄປທີ່ຕຳແໜ່ງໃໝ່"

#. (itstool) path: section/para
#: C/goscaja.xml:1742
msgid "To drag a file or folder to a new location, perform the following steps:"
msgstr "ເພື່ອລາກໄຟລ໌ ຫຼື ໂຟນເດີໄປທີ່ຕຳແໜ່ງໃໝ່, ໃຫ້ເຮັດຕາມຂັ້ນຕອນດັ່ງນີ້:"

#. (itstool) path: listitem/para
#: C/goscaja.xml:1745
#: C/goscaja.xml:1787
msgid "Open two file manager windows:"
msgstr "ເປີດໜ້າຕ່າງຕົວຈັດການໄຟລ໌ສອງໜ້າຕ່າງ:"

#. (itstool) path: listitem/para
#: C/goscaja.xml:1747
#: C/goscaja.xml:1789
msgid "The window containing the item you want to move."
msgstr "ໜ້າຕ່າງທີ່ມີລາຍການທີ່ເຈົ້າຕ້ອງການຍ້າຍ."

#. (itstool) path: listitem/para
#: C/goscaja.xml:1748
#: C/goscaja.xml:1790
msgid "The window you want to move it to, or the window containing the folder you want to move it to."
msgstr ""
"ໜ້າຕ່າງທີ່ເຈົ້າຕ້ອງການຍ້າຍມັນໄປໃສ່, ຫຼື ໜ້າຕ່າງທີ່ມີໂຟນເດີທີ່ເຈົ້າຕ້ອງການຍ້າຍມັນໄປໃສ່."

#. (itstool) path: listitem/para
#: C/goscaja.xml:1752
msgid "Drag the file or folder that you want to move to the new location. If the new location is a window, drop it anywhere in the window. If the new location is a folder icon, drop the item you are dragging on the folder."
msgstr ""
"ລາກໄຟລ໌ ຫຼື ໂຟນເດີທີ່ເຈົ້າຕ້ອງການຍ້າຍໄປທີ່ຕຳແໜ່ງໃໝ່. ຫາກຕຳແໜ່ງໃໝ່ເປັນໜ້າຕ່າງ, ໃຫ້ວາງມັນໄວ້ບ່ອນໃດກໍໄດ້ໃ"
"ນໜ້າຕ່າງນັ້ນ. ຫາກຕຳແໜ່ງໃໝ່ເປັນໄອຄອນໂຟນເດີ, ໃຫ້ວາງລາຍການທີ່ເຈົ້າລາກລົງໃສ່ເທິງໂຟນເດີນັ້ນ."

#. (itstool) path: section/para
#: C/goscaja.xml:1755
msgid "To move the file or folder to a folder that is one level below the current location, do not open a new window. Instead, drag the file or folder to the new location in the same window."
msgstr ""
"ເພື່ອຍ້າຍໄຟລ໌ ຫຼື ໂຟນເດີໄປຍັງໂຟນເດີທີ່ຢູ່ລຸ່ມຕຳແໜ່ງປັດຈຸບັນໜຶ່ງລະດັບ, ບໍ່ຈຳເປັນຕ້ອງເປີດໜ້າຕ່າງໃໝ່. ແຕ່ໃຫ້ລາກໄ"
"ຟລ໌ ຫຼື ໂຟນເດີໄປທີ່ຕຳແໜ່ງໃໝ່ໃນໜ້າຕ່າງດຽວກັນ."

#. (itstool) path: tip/para
#: C/goscaja.xml:1758
#: C/goscaja.xml:1801
#: C/goscaja.xml:2012
msgid "For more on dragging items, see <xref linkend=\"caja-dragndrop\"/>."
msgstr ""
"ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບການລາກລາຍການ, ເບິ່ງ <xref linkend=\"caja-dragndrop\"/>."

#. (itstool) path: info/title
#: C/goscaja.xml:1761
msgid "Cut and Paste to the New Location"
msgstr "ຕັດ ແລະ ວາງ ໄປທີ່ຕຳແໜ່ງໃໝ່"

#. (itstool) path: section/para
#: C/goscaja.xml:1762
msgid "You can cut a file or folder and paste the file or folder into another folder, as follows:"
msgstr ""
"ເຈົ້າສາມາດຕັດໄຟລ໌ ຫຼື ໂຟນເດີ ແລະ ເອົາໄປວາງໄວ້ໃນອີກໂຟນເດີໜຶ່ງໄດ້ ດັ່ງນີ້:"

#. (itstool) path: listitem/para
#: C/goscaja.xml:1766
msgid "Select the file or folder that you want to move, then choose <menuchoice><guimenu>Edit</guimenu><guimenuitem>Cut</guimenuitem></menuchoice>."
msgstr ""
"ເລືອກໄຟລ໌ ຫຼື ໂຟນເດີທີ່ເຈົ້າຕ້ອງການຍ້າຍ, ແລ້ວເລືອກ <menuchoice><guimenu>ແກ້ໄຂ</guimenu>"
"<guimenuitem>ຕັດ</guimenuitem></menuchoice>."

#. (itstool) path: listitem/para
#: C/goscaja.xml:1769
msgid "Open the folder to which you want to move the file or folder, then choose <menuchoice><guimenu>Edit</guimenu><guimenuitem>Paste</guimenuitem></menuchoice>."
msgstr ""
"ເປີດໂຟນເດີທີ່ເຈົ້າຕ້ອງການຍ້າຍໄຟລ໌ ຫຼື ໂຟນເດີໄປໃສ່, ແລ້ວເລືອກ <menuchoice><guimenu>ແກ້ໄຂ</"
"guimenu><guimenuitem>ວາງ</guimenuitem></menuchoice>."

#. (itstool) path: info/title
#: C/goscaja.xml:1776
msgid "Copying a File or Folder"
msgstr "ການສຳເນົາໄຟລ໌ ຫຼື ໂຟນເດີ"

#. (itstool) path: section/indexterm
#: C/goscaja.xml:1777
msgid "<primary>file manager</primary> <secondary>copying files and folders</secondary>"
msgstr ""
"<primary>ຕົວຈັດການໄຟລ໌</primary> <secondary>ການສຳເນົາໄຟລ໌ ແລະ ໂຟນເດີ</secondary>"

#. (itstool) path: section/para
#: C/goscaja.xml:1781
msgid "You can copy a file or folder by dragging it with the mouse, or with the copy and paste commands. The following sections describe these two methods."
msgstr ""
"ເຈົ້າສາມາດສຳເນົາໄຟລ໌ ຫຼື ໂຟນເດີໄດ້ໂດຍການລາກດ້ວຍເມົາສ໌ ຫຼື ໃຊ້ຄຳສັ່ງສຳເນົາ (copy) ແລະ ວາງ "
"(paste). ສ່ວນຕ່າງໆຕໍ່ໄປນີ້ຈະອະທິບາຍທັງສອງວິທີນັ້ນ."

#. (itstool) path: section/para
#: C/goscaja.xml:1784
msgid "To copy a file or folder, perform the following steps:"
msgstr "ເພື່ອສຳເນົາໄຟລ໌ ຫຼື ໂຟນເດີ, ໃຫ້ເຮັດຕາມຂັ້ນຕອນດັ່ງນີ້:"

#. (itstool) path: listitem/para
#: C/goscaja.xml:1794
msgid "Drag the file or folder that you want to move to the new location. Press-and-hold <keycap>Ctrl</keycap> either before or during the drag. If the new location is a window, drop it anywhere in the window. If the new location is a folder icon, drop the item you are dragging on the folder."
msgstr ""
"ລາກໄຟລ໌ ຫຼື ໂຟນເດີທີ່ເຈົ້າຕ້ອງການຍ້າຍໄປທີ່ຕຳແໜ່ງໃໝ່. ກົດ <keycap>Ctrl</keycap> ຄ້າງໄວ້ກ່ອນ ຫຼື ໃນ"
"ລະຫວ່າງການລາກ. ຫາກຕຳແໜ່ງໃໝ່ເປັນໜ້າຕ່າງ, ໃຫ້ວາງມັນໄວ້ບ່ອນໃດກໍໄດ້ໃນໜ້າຕ່າງນັ້ນ. ຫາກຕຳແໜ່ງໃໝ່ເປັນໄອ"
"ຄອນໂຟນເດີ, ໃຫ້ວາງລາຍການທີ່ເຈົ້າລາກລົງໃສ່ເທິງໂຟນເດີນັ້ນ."

#. (itstool) path: section/para
#: C/goscaja.xml:1797
msgid "To copy the file or folder to a folder that is one level below the current location, do not open a new window. Instead, grab the file or folder, then press-and-hold <keycap>Ctrl</keycap>. Drag the file or folder to the new location in the same window."
msgstr ""
"ເພື່ອສຳເນົາໄຟລ໌ ຫຼື ໂຟນເດີໄປຍັງໂຟນເດີທີ່ຢູ່ລຸ່ມຕຳແໜ່ງປັດຈຸບັນໜຶ່ງລະດັບ, ບໍ່ຈຳເປັນຕ້ອງເປີດໜ້າຕ່າງໃໝ່. ແຕ່ໃຫ້ຈັບ"
"ໄຟລ໌ ຫຼື ໂຟນເດີນັ້ນ, ແລ້ວກົດ <keycap>Ctrl</keycap> ຄ້າງໄວ້. ຈາກນັ້ນລາກໄຟລ໌ ຫຼື ໂຟນເດີໄປທີ່ຕຳແໜ່ງ"
"ໃໝ່ໃນໜ້າຕ່າງດຽວກັນ."

#. (itstool) path: info/title
#: C/goscaja.xml:1804
msgid "Copy and Paste to the New Location"
msgstr "ສຳເນົາ ແລະ ວາງ ໄປທີ່ຕຳແໜ່ງໃໝ່"

#. (itstool) path: section/para
#: C/goscaja.xml:1806
msgid "You can copy a file or folder and paste the file or folder into another folder, as follows:"
msgstr ""
"ເຈົ້າສາມາດສຳເນົາໄຟລ໌ ຫຼື ໂຟນເດີ ແລະ ເອົາໄປວາງໄວ້ໃນອີກໂຟນເດີໜຶ່ງໄດ້ ດັ່ງນີ້:"

#. (itstool) path: listitem/para
#: C/goscaja.xml:1810
msgid "Select the file or folder that you want to copy, then choose <menuchoice><guimenu>Edit</guimenu><guimenuitem>Copy</guimenuitem></menuchoice>."
msgstr ""
"ເລືອກໄຟລ໌ ຫຼື ໂຟນເດີທີ່ເຈົ້າຕ້ອງການສຳເນົາ, ແລ້ວເລືອກ <menuchoice><guimenu>ແກ້ໄຂ</guimenu>"
"<guimenuitem>ສຳເນົາ</guimenuitem></menuchoice>."

#. (itstool) path: listitem/para
#: C/goscaja.xml:1813
msgid "Open the folder to which you want to copy the file or folder, then choose <menuchoice><guimenu>Edit</guimenu><guimenuitem>Paste</guimenuitem></menuchoice>."
msgstr ""
"ເປີດໂຟນເດີທີ່ເຈົ້າຕ້ອງການສຳເນົາໄຟລ໌ ຫຼື ໂຟນເດີໄປໃສ່, ແລ້ວເລືອກ <menuchoice><guimenu>ແກ້ໄຂ</"
"guimenu><guimenuitem>ວາງ</guimenuitem></menuchoice>."

#. (itstool) path: info/title
#: C/goscaja.xml:1820
msgid "Duplicating a File or Folder"
msgstr "ການເຮັດສຳເນົາໄຟລ໌ ຫຼື ໂຟນເດີຊ້ຳ"

#. (itstool) path: section/indexterm
#: C/goscaja.xml:1821
msgid "<primary>file manager</primary> <secondary>duplicating files and folders</secondary>"
msgstr ""
"<primary>ຕົວຈັດການໄຟລ໌</primary> <secondary>ການເຮັດສຳເນົາໄຟລ໌ ແລະ ໂຟນເດີຊ້ຳ</"
"secondary>"

#. (itstool) path: section/para
#: C/goscaja.xml:1826
msgid "To create a copy of a file or folder in the current folder, perform the following steps:"
msgstr ""
"ເພື່ອສ້າງສຳເນົາຂອງໄຟລ໌ ຫຼື ໂຟນເດີໃນໂຟນເດີປັດຈຸບັນ, ໃຫ້ເຮັດຕາມຂັ້ນຕອນດັ່ງນີ້:"

#. (itstool) path: listitem/para
#: C/goscaja.xml:1830
msgid "Select the file or folder that you want to duplicate."
msgstr "ເລືອກໄຟລ໌ ຫຼື ໂຟນເດີທີ່ເຈົ້າຕ້ອງການເຮັດຊ້ຳ."

#. (itstool) path: listitem/para
#: C/goscaja.xml:1833
msgid "Choose <menuchoice><guimenu>Edit</guimenu><guimenuitem>Duplicate</guimenuitem></menuchoice>."
msgstr ""
"ເລືອກ <menuchoice><guimenu>ແກ້ໄຂ</guimenu><guimenuitem>ເຮັດຊ້ຳ</guimenuitem></"
"menuchoice>."

#. (itstool) path: listitem/para
#: C/goscaja.xml:1834
msgid "A copy of the file or folder appears in the current folder."
msgstr "ສຳເນົາຂອງໄຟລ໌ ຫຼື ໂຟນເດີຈະປາກົດຂຶ້ນໃນໂຟນເດີປັດຈຸບັນ."

#. (itstool) path: info/title
#: C/goscaja.xml:1839
msgid "Creating a Folder"
msgstr "ການສ້າງໂຟນເດີ"

#. (itstool) path: section/indexterm
#: C/goscaja.xml:1840
msgid "<primary>file manager</primary> <secondary>creating folders</secondary>"
msgstr "<primary>ຕົວຈັດການໄຟລ໌</primary> <secondary>ການສ້າງໂຟນເດີ</secondary>"

#. (itstool) path: section/para
#: C/goscaja.xml:1844
msgid "To create a folder, perform the following steps:"
msgstr "ເພື່ອສ້າງໂຟນເດີ, ໃຫ້ເຮັດຕາມຂັ້ນຕອນດັ່ງນີ້:"

#. (itstool) path: listitem/para
#: C/goscaja.xml:1847
msgid "Open the folder where you want to create the new folder."
msgstr "ເປີດໂຟນເດີບ່ອນທີ່ເຈົ້າຕ້ອງການສ້າງໂຟນເດີໃໝ່."

#. (itstool) path: listitem/para
#: C/goscaja.xml:1850
msgid "Choose <menuchoice><guimenu>File</guimenu><guimenuitem>Create Folder</guimenuitem></menuchoice>. Alternatively, right-click on the background of the window, then choose <guimenuitem>Create Folder</guimenuitem>."
msgstr ""
"ເລືອກ <menuchoice><guimenu>ໄຟລ໌</guimenu><guimenuitem>ສ້າງໂຟນເດີ</guimenuitem></"
"menuchoice>. ຫຼື ອີກວິທີໜຶ່ງ, ຄລິກຂວາໃສ່ພື້ນຫຼັງຂອງໜ້າຕ່າງ, ແລ້ວເລືອກ <guimenuitem>ສ້າງໂຟນເດີ</"
"guimenuitem>."

#. (itstool) path: listitem/para
#: C/goscaja.xml:1852
msgid "An <guilabel>untitled</guilabel> folder is added to the location. The name of the folder is selected."
msgstr ""
"ໂຟນເດີ <guilabel>ບໍ່ມີຊື່</guilabel> ຈະຖືກເພີ່ມເຂົ້າໃນຕຳແໜ່ງນັ້ນ. ຊື່ຂອງໂຟນເດີຈະຖືກເລືອກໄວ້."

#. (itstool) path: listitem/para
#: C/goscaja.xml:1856
msgid "Type a name for the folder, then press <keycap>Return</keycap>."
msgstr "ພິມຊື່ໂຟນເດີ, ແລ້ວກົດ <keycap>Return</keycap>."

#. (itstool) path: info/title
#: C/goscaja.xml:1861
msgid "Templates and Documents"
msgstr "ແມ່ແບບ ແລະ ເອກະສານ"

#. (itstool) path: section/indexterm
#: C/goscaja.xml:1862
msgid "<primary>file manager</primary> <secondary>creating documents</secondary>"
msgstr "<primary>ຕົວຈັດການໄຟລ໌</primary> <secondary>ການສ້າງເອກະສານ</secondary>"

#. (itstool) path: section/para
#: C/goscaja.xml:1866
msgid "You can create templates from documents that you frequently create. For example, if you often create invoices, you can create an empty invoice document and save the document as <literal>invoice.doc</literal> in the <literal>$HOME/Templates</literal> folder."
msgstr ""
"ເຈົ້າສາມາດສ້າງແມ່ແບບຈາກເອກະສານທີ່ເຈົ້າສ້າງເລື້ອຍໆໄດ້. ຕົວຢ່າງ: ຫາກເຈົ້າສ້າງໃບບິນເລື້ອຍໆ, ເຈົ້າສາມາດ"
"ສ້າງເອກະສານໃບບິນເປົ່າ ແລະ ບັນທຶກເອກະສານເປັນ <literal>invoice.doc</literal> ໄວ້ໃນໂຟນເ"
"ດີ <literal>$HOME/Templates</literal>."

#. (itstool) path: section/para
#: C/goscaja.xml:1870
msgid "You can also access the templates folder from a file browser window. Choose <menuchoice><guimenu>Go</guimenu><guimenuitem>Templates</guimenuitem></menuchoice>."
msgstr ""
"ເຈົ້າສາມາດເຂົ້າເຖິງໂຟນເດີແມ່ແບບໄດ້ຈາກໜ້າຕ່າງບຣາວເຊີໄຟລ໌. ໃຫ້ເລືອກ <menuchoice><guimenu>ໄປ</"
"guimenu><guimenuitem>ແມ່ແບບ</guimenuitem></menuchoice>."

#. (itstool) path: section/para
#: C/goscaja.xml:1872
msgid "The template name is displayed as a submenu item in the <guilabel>Create Document</guilabel> menu."
msgstr ""
"ຊື່ແມ່ແບບຈະຖືກສະແດງເປັນລາຍການເມນູຍ່ອຍໃນເມນູ <guilabel>ສ້າງເອກະສານ</guilabel>."

#. (itstool) path: section/para
#: C/goscaja.xml:1874
msgid "You can also create subfolders in the template folder. Subfolders display as submenus in the menu."
msgstr ""
"ເຈົ້າສາມາດສ້າງໂຟນເດີຍ່ອຍໃນໂຟນເດີແມ່ແບບໄດ້ຄືກັນ. ໂຟນເດີຍ່ອຍຈະສະແດງເປັນເມນູຍ່ອຍໃນເມນູ."

#. (itstool) path: section/para
#: C/goscaja.xml:1876
msgid "You can also share templates. Create a symbolic link from the template folder to the folder containing the shared templates."
msgstr ""
"ເຈົ້າສາມາດແບ່ງປັນແມ່ແບບໄດ້ຄືກັນ. ໂດຍການສ້າງລິ້ງສັນຍະລັກຈາກໂຟນເດີແມ່ແບບໄປຫາໂຟນເດີທີ່ມີແມ່ແບບທີ່ແບ່ງປັ"
"ນ."

#. (itstool) path: info/title
#: C/goscaja.xml:1879
msgid "To Create a Document"
msgstr "ເພື່ອສ້າງເອກະສານ"

#. (itstool) path: section/para
#: C/goscaja.xml:1880
msgid "If you have document templates, you can choose to create a document from one of the installed templates."
msgstr ""
"ຫາກເຈົ້າມີແມ່ແບບເອກະສານ, ເຈົ້າສາມາດເລືອກສ້າງເອກະສານຈາກແມ່ແບບທີ່ມີຢູ່ໄດ້."

#. (itstool) path: section/para
#: C/goscaja.xml:1882
msgid "To create a document perform the following steps:"
msgstr "ເພື່ອສ້າງເອກະສານ, ໃຫ້ເຮັດຕາມຂັ້ນຕອນດັ່ງນີ້:"

#. (itstool) path: listitem/para
#: C/goscaja.xml:1885
msgid "Select the folder where you want to create the new document."
msgstr "ເລືອກໂຟນເດີບ່ອນທີ່ເຈົ້າຕ້ອງການສ້າງເອກະສານໃໝ່."

#. (itstool) path: listitem/para
#: C/goscaja.xml:1888
msgid "Choose <menuchoice><guimenu>File</guimenu><guimenuitem>Create Document</guimenuitem></menuchoice>. Alternatively, right-click on the background of the view pane, then choose <guimenuitem>Create Document</guimenuitem>."
msgstr ""
"ເລືອກ <menuchoice><guimenu>ໄຟລ໌</guimenu><guimenuitem>ສ້າງເອກະສານ</guimenuitem>"
"</menuchoice>. ຫຼື ອີກວິທີໜຶ່ງ, ຄລິກຂວາໃສ່ພື້ນຫຼັງຂອງສ່ວນສະແດງຜົນ, ແລ້ວເລືອກ <guimenuitem>ສ້າງເ"
"ອກະສານ</guimenuitem>."

#. (itstool) path: listitem/para
#: C/goscaja.xml:1890
msgid "The names of any available templates are displayed as submenu items from the <guilabel>Create Document</guilabel> menu."
msgstr ""
"ຊື່ຂອງແມ່ແບບທີ່ມີຢູ່ຈະຖືກສະແດງເປັນລາຍການເມນູຍ່ອຍຈາກເມນູ <guilabel>ສ້າງເອກະສານ</guilabel>."

#. (itstool) path: listitem/para
#: C/goscaja.xml:1894
msgid "Double-click on the template name for the document that you want to create."
msgstr "ດັບເບິລຄລິກໃສ່ຊື່ແມ່ແບບສຳລັບເອກະສານທີ່ເຈົ້າຕ້ອງການສ້າງ."

#. (itstool) path: listitem/para
#: C/goscaja.xml:1898
msgid "Rename the document before saving to the appropriate folder."
msgstr "ປ່ຽນຊື່ເອກະສານກ່ອນທີ່ຈະບັນທຶກລົງໃນໂຟນເດີທີ່ເໝາະສົມ."

#. (itstool) path: info/title
#: C/goscaja.xml:1904
msgid "Renaming a File or Folder"
msgstr "ການປ່ຽນຊື່ໄຟລ໌ ຫຼື ໂຟນເດີ"

#. (itstool) path: section/indexterm
#: C/goscaja.xml:1905
msgid "<primary>file manager</primary> <secondary>renaming folders</secondary>"
msgstr ""
"<primary>ຕົວຈັດການໄຟລ໌</primary> <secondary>ການປ່ຽນຊື່ໂຟນເດີ</secondary>"

#. (itstool) path: section/para
#: C/goscaja.xml:1909
msgid "To rename a file or folder perform the following steps:"
msgstr "ເພື່ອປ່ຽນຊື່ໄຟລ໌ ຫຼື ໂຟນເດີ, ໃຫ້ເຮັດຕາມຂັ້ນຕອນດັ່ງນີ້:"

#. (itstool) path: listitem/para
#: C/goscaja.xml:1912
msgid "Select the file or folder that you want to rename."
msgstr "ເລືອກໄຟລ໌ ຫຼື ໂຟນເດີທີ່ເຈົ້າຕ້ອງການປ່ຽນຊື່."

#. (itstool) path: listitem/para
#: C/goscaja.xml:1915
msgid "Choose <menuchoice><guimenu>Edit</guimenu><guimenuitem>Rename</guimenuitem></menuchoice>. Alternatively, right-click on the file or folder, then choose <guimenuitem>Rename</guimenuitem>."
msgstr ""
"ເລືອກ <menuchoice><guimenu>ແກ້ໄຂ</guimenu><guimenuitem>ປ່ຽນຊື່</guimenuitem></"
"menuchoice>. ຫຼື ອີກວິທີໜຶ່ງ, ຄລິກຂວາໃສ່ໄຟລ໌ ຫຼື ໂຟນເດີ, ແລ້ວເລືອກ <guimenuitem>ປ່ຽນຊື່</"
"guimenuitem>."

#. (itstool) path: listitem/para
#: C/goscaja.xml:1917
msgid "The name of the file or folder is selected."
msgstr "ຊື່ຂອງໄຟລ໌ ຫຼື ໂຟນເດີຈະຖືກເລືອກໄວ້."

#. (itstool) path: listitem/para
#: C/goscaja.xml:1920
msgid "Type a new name for the file or folder, then press <keycap>Return</keycap>."
msgstr "ພິມຊື່ໃໝ່ສຳລັບໄຟລ໌ ຫຼື ໂຟນເດີ, ແລ້ວກົດ <keycap>Return</keycap>."

#. (itstool) path: info/title
#: C/goscaja.xml:1925
msgid "Moving a File or Folder to Trash"
msgstr "ການຍ້າຍໄຟລ໌ ຫຼື ໂຟນເດີໄປທີ່ຖັງຂີ້ເຫຍື້ອ"

#. (itstool) path: section/indexterm
#: C/goscaja.xml:1926
msgid "<primary>file manager</primary> <secondary>Trash</secondary> <see>Trash</see>"
msgstr ""
"<primary>ຕົວຈັດການໄຟລ໌</primary> <secondary>ຖັງຂີ້ເຫຍື້ອ</secondary> <see>Trash</see>"

#. (itstool) path: section/indexterm
#: C/goscaja.xml:1931
msgid "<primary>Trash</primary> <secondary>moving files or folders to</secondary>"
msgstr ""

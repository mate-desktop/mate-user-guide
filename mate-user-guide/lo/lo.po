#. (itstool) path: entry/para
#: C/goscustdesk.xml:1808
msgid "<guilabel>Beep when a key is pressed</guilabel>"
msgstr "<guilabel>ສົ່ງສຽງດັງເມື່ອກົດປຸ່ມ</guilabel>"

#. (itstool) path: entry/para
#: C/goscustdesk.xml:1813

msgstr "<guilabel>ບໍ່ມີ</guilabel>"

#. (itstool) path: entry/para
#: C/goscaja.xml:3693
msgid "Choose this option to display no information for the item."
msgstr "ເລືອກຕົວເລືອກນີ້ເພື່ອບໍ່ໃຫ້ສະແດງຂໍ້ມູນໃດໆສຳລັບລາຍການ."

#. (itstool) path: section/para
#: C/goscaja.xml:3699
msgid "The date <guilabel>Format</guilabel> option lets you choose how the date is displayed throughout Caja."
msgstr ""
"ຕົວເລືອກ <guilabel>ຮູບແບບ</guilabel> ວັນທີ ຊ່ວຍໃຫ້ທ່ານເລືອກວິທີສະແດງວັນທີໃນທົ່ວລະບົບ Caja."

#. (itstool) path: info/title
#: C/goscaja.xml:3704
msgid "List Columns Preferences"
msgstr "ການຕັ້ງຄ່າຄໍລຳລາຍການ"

#. (itstool) path: section/para
#: C/goscaja.xml:3705
msgid "You can specify what information is displayed in list view in file manager windows. You can specify which columns are displayed in list view, and the order in which the columns are displayed."
msgstr ""
"ທ່ານສາມາດລະບຸຂໍ້ມູນທີ່ຈະໃຫ້ສະແດງໃນມຸມມອງລາຍການໃນໜ້າຕ່າງຕົວຈັດການໄຟລ໌. ທ່ານສາມາດລະບຸວ່າຄໍລຳໃດທີ່ຈະ"
"ໃຫ້ສະແດງໃນມຸມມອງລາຍການ, ແລະ ລຳດັບການສະແດງຜົນຂອງຄໍລຳເຫຼົ່ານັ້ນ."

#. (itstool) path: section/para
#: C/goscaja.xml:3708
msgid "To set your preferences for list columns, choose <menuchoice><guimenu>Edit</guimenu><guimenuitem>Preferences</guimenuitem></menuchoice>. Click on the <guilabel>List Columns</guilabel> tab to display the <guilabel>List Columns</guilabel> tabbed section."
msgstr ""
"ເພື່ອຕັ້ງຄ່າຄວາມມັກຂອງທ່ານສຳລັບຄໍລຳລາຍການ, ໃຫ້ເລືອກ <menuchoice><guimenu>ແກ້ໄຂ</guimenu>"
"<guimenuitem>ການຕັ້ງຄ່າ</guimenuitem></menuchoice>. ຄລິກໃສ່ແທັບ <guilabel>ຄໍລຳລາຍກາ"
"ນ</guilabel> ເພື່ອສະແດງສ່ວນຂອງແທັບ <guilabel>ຄໍລຳລາຍການ</guilabel>."

#. (itstool) path: section/para
#: C/goscaja.xml:3710
msgid "To specify a column to display in list view, select the option that corresponds to the column, then click on the <guibutton>Show</guibutton> button. To remove a column from the list view, select the option that corresponds to the column, then click on the <guibutton>Hide</guibutton> button."
msgstr ""
"ເພື່ອລະບຸຄໍລຳທີ່ຈະສະແດງໃນມຸມມອງລາຍການ, ໃຫ້ເລືອກຕົວເລືອກທີ່ກົງກັບຄໍລຳນັ້ນ, ແລ້ວຄລິກໃສ່ປຸ່ມ "
"<guibutton>ສະແດງ</guibutton>. ເພື່ອເອົາຄໍລຳອອກຈາກມຸມມອງລາຍການ, ໃຫ້ເລືອກຕົວເລືອກທີ່ກົງກັບຄໍລ"
"ຳນັ້ນ, ແລ້ວຄລິກໃສ່ປຸ່ມ <guibutton>ຊ່ອນ</guibutton>."

#. (itstool) path: section/para
#: C/goscaja.xml:3714
msgid "Use the <guibutton>Move Up</guibutton> and <guibutton>Move Down</guibutton> buttons to specify the position of columns in list view."
msgstr ""
"ໃຊ້ປຸ່ມ <guibutton>ຍ້າຍຂຶ້ນ</guibutton> ແລະ <guibutton>ຍ້າຍລົງ</guibutton> ເພື່ອລະບຸຕຳແໜ່"

msgstr "ສະຖານະ"

#. (itstool) path: entry/para
#: C/gospanel.xml:1580
msgid "Indicates..."
msgstr "ໝາຍເຖິງ..."

#. (itstool) path: entry/para
#: C/gospanel.xml:1585
msgid "The button is pressed in."
msgstr "ປຸ່ມຖືກກົດລົງ."

#. (itstool) path: entry/para
#: C/gospanel.xml:1586
msgid "The window has focus."
msgstr "ປ່ອງຢ້ຽມກຳລັງຖືກໃຊ້ງານຢູ່."

#. (itstool) path: entry/para
#: C/gospanel.xml:1589
msgid "The button appears faded. The button text is surrounded by square brackets."
msgstr "ປຸ່ມປາກົດເປັນສີຈາງໆ. ຂໍ້ຄວາມເທິງປຸ່ມຖືກລ້ອມຮອບດ້ວຍວົງເລັບຫຼ່ຽມ."

#. (itstool) path: entry/para
#: C/gospanel.xml:1590
msgid "The window is minimized."
msgstr "ປ່ອງຢ້ຽມຖືກຫຍໍ້ລົງ."

#. (itstool) path: entry/para
#: C/gospanel.xml:1593
msgid "The button is not pressed in, and is not faded."
msgstr "ປຸ່ມບໍ່ໄດ້ຖືກກົດລົງ ແລະ ບໍ່ໄດ້ເປັນສີຈາງ."

#. (itstool) path: entry/para
#: C/gospanel.xml:1594
msgid "The window is displayed on the desktop and is not minimized."
msgstr "ປ່ອງຢ້ຽມກຳລັງສະແດງຢູ່ເທິງເດັສທັອບ ແລະ ບໍ່ໄດ້ຖືກຫຍໍ້ລົງ."

#. (itstool) path: entry/para
#: C/gospanel.xml:1597
msgid "There is a number in parentheses at the end of the button title."
msgstr "ມີຕົວເລກຢູ່ໃນວົງເລັບຢູ່ທ້າຍຊື່ຂອງປຸ່ມ."

#. (itstool) path: entry/para
#: C/gospanel.xml:1598
msgid "The button represents a group of buttons."
msgstr "ປຸ່ມນັ້ນສະແດງເຖິງກຸ່ມຂອງປຸ່ມຕ່າງໆ."

#. (itstool) path: section/para
#: C/gospanel.xml:1606
msgid "You can use <application>Window List</application> to perform the following tasks:"
msgstr ""
"ເຈົ້າສາມາດໃຊ້ <application>ລາຍຊື່ປ່ອງຢ້ຽມ</application> ເພື່ອເຮັດວຽກດັ່ງຕໍ່ໄປນີ້:"

#. (itstool) path: listitem/para
#: C/gospanel.xml:1609
msgid "To give focus to a window"
msgstr "ເພື່ອເລືອກໃຊ້ງານປ່ອງຢ້ຽມ"

#. (itstool) path: listitem/para
#: C/gospanel.xml:1610
msgid "If you click on the Window List button that represents a window that is on the desktop but does not have focus, the applet gives focus to the window."
msgstr ""
"ຫາກເຈົ້າຄລິກໃສ່ປຸ່ມລາຍຊື່ປ່ອງຢ້ຽມທີ່ສະແດງເຖິງປ່ອງຢ້ຽມທີ່ຢູ່ເທິງເດັສທັອບແຕ່ບໍ່ໄດ້ຖືກໃຊ້ງານຢູ່, ແອັບເພັດຈະສະຫຼັບໄ"
"ປໃຊ້ງານປ່ອງຢ້ຽມນັ້ນ."

#. (itstool) path: listitem/para
#: C/gospanel.xml:1613
msgid "To minimize a window"
msgstr "ເພື່ອຫຍໍ້ປ່ອງຢ້ຽມລົງ"

#. (itstool) path: listitem/para
#: C/gospanel.xml:1614
msgid "If you click on the Window List button that represents the window that has focus, the applet minimizes the window."
msgstr ""
"ຫາກເຈົ້າຄລິກໃສ່ປຸ່ມລາຍຊື່ປ່ອງຢ້ຽມທີ່ສະແດງເຖິງປ່ອງຢ້ຽມທີ່ກຳລັງໃຊ້ງານຢູ່, ແອັບເພັດຈະຫຍໍ້ປ່ອງຢ້ຽມນັ້ນລົງ."

#. (itstool) path: listitem/para
#: C/gospanel.xml:1617
msgid "To restore a minimized window"
msgstr "ເພື່ອຄືນຄ່າປ່ອງຢ້ຽມທີ່ຫຍໍ້ໄວ້"

#. (itstool) path: listitem/para
#: C/gospanel.xml:1618
msgid "If you click on the Window List button that represents a minimized window, the applet restores the window."
msgstr ""
"ຫາກເຈົ້າຄລິກໃສ່ປຸ່ມລາຍຊື່ປ່ອງຢ້ຽມທີ່ສະແດງເຖິງປ່ອງຢ້ຽມທີ່ຖືກຫຍໍ້ໄວ້, ແອັບເພັດຈະຄືນຄ່າປ່ອງຢ້ຽມນັ້ນໃຫ້ກັບມາສະແດ"
"ງຄືເກົ່າ."

#. (itstool) path: section/para
#: C/gospanel.xml:1622
msgid "You can change the order of the Window List buttons by dragging a button to a different location on the Window List."
msgstr ""
"ເຈົ້າສາມາດປ່ຽນລຳດັບຂອງປຸ່ມລາຍຊື່ປ່ອງຢ້ຽມໄດ້ ໂດຍການລາກປຸ່ມໄປວາງໄວ້ ໃນສະຖານທີ່ອື່ນໃນລາຍຊື່ປ່ອງຢ້ຽມ."

#. (itstool) path: info/title
#: C/gospanel.xml:1626
msgid "Preferences"
msgstr "ການຕັ້ງຄ່າ"

#. (itstool) path: section/para
#: C/gospanel.xml:1627
msgid "To configure the <application>Window List</application>, right-click on the handle to the left of the window buttons, then choose <guimenuitem>Preferences</guimenuitem>. The following preferences can be changed:"
msgstr ""
"ເພື່ອຕັ້ງຄ່າ <application>ລາຍຊື່ປ່ອງຢ້ຽມ</application>, ໃຫ້ຄລິກຂວາໃສ່ບ່ອນຈັບທາງດ້ານຊ້າຍຂອງປຸ່ມປ່"
"ອງຢ້ຽມ, ແລ້ວເລືອກ <guimenuitem>ການປັບແຕ່ງ</guimenuitem>. ເຈົ້າສາມາດປ່ຽນແປງການປັບແຕ່ງດັ່ງຕໍ່"
"ໄປນີ້ໄດ້:"

#. (itstool) path: varlistentry/term
#: C/gospanel.xml:1636
msgid "<guilabel>Window List Content</guilabel>"
msgstr "<guilabel>ເນື້ອຫາລາຍຊື່ປ່ອງຢ້ຽມ</guilabel>"

#. (itstool) path: listitem/para
#: C/gospanel.xml:1638
msgid "To specify which windows to display in the Window List, select one of the following options:"
msgstr ""
"ເພື່ອລະບຸວ່າຈະໃຫ້ສະແດງປ່ອງຢ້ຽມໃດໃນລາຍຊື່ປ່ອງຢ້ຽມ, ໃຫ້ເລືອກຕົວເລືອກໃດໜຶ່ງດັ່ງນີ້:"

#. (itstool) path: listitem/para
#: C/gospanel.xml:1641
msgid "<guilabel>Show windows from current workspace</guilabel>"
msgstr "<guilabel>ສະແດງປ່ອງຢ້ຽມຈາກພື້ນທີ່ເຮັດວຽກປັດຈຸບັນ</guilabel>"

#. (itstool) path: listitem/para
#: C/gospanel.xml:1642
msgid "Select this option to only show the windows that are open in the current workspace."
msgstr ""
"ເລືອກຕົວເລືອກນີ້ເພື່ອສະແດງສະເພາະປ່ອງຢ້ຽມທີ່ເປີດຢູ່ໃນພື້ນທີ່ເຮັດວຽກປັດຈຸບັນເທົ່ານັ້ນ."

#. (itstool) path: listitem/para

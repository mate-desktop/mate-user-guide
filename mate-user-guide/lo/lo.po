msgstr "<guilabel>ປະເພດ MIME</guilabel>"

#. (itstool) path: entry/para
#: C/goscaja.xml:3683
#: C/goscaja.xml:3802
msgid "Choose this option to display the MIME type of the item."
msgstr "ເລືອກຕົວເລືອກນີ້ເພື່ອສະແດງປະເພດ MIME ຂອງລາຍການ."

#. (itstool) path: entry/para
#: C/goscaja.xml:3688

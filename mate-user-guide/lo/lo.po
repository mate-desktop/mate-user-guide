msgid "For each of the owner, the group, and all other users, choose from these folder access permissions:"
msgstr ""
"ສຳລັບແຕ່ລະປະເພດ: ເຈົ້າຂອງ, ກຸ່ມ, ແລະ ຜູ້ໃຊ້ອື່ນໆ, ໃຫ້ເລືອກການກຳນົດສິດການເຂົ້າເຖິງໂຟນເດີດັ່ງນີ້:"

#. (itstool) path: listitem/para
#: C/goscaja.xml:2244
msgid "No access to the folder is possible. (You can't set this for the owner.)"
msgstr "ບໍ່ສາມາດເຂົ້າເຖິງໂຟນເດີໄດ້. (ເຈົ້າບໍ່ສາມາດຕັ້ງຄ່ານີ້ໃຫ້ກັບເຈົ້າຂອງໄດ້.)"

#. (itstool) path: varlistentry/term
#: C/goscaja.xml:2247
msgid "List files only"
msgstr "ລາຍຊື່ໄຟລ໌ເທົ່ານັ້ນ"

#. (itstool) path: listitem/para
#: C/goscaja.xml:2249
msgid "The users can see the items in the folder, but not open any of them."
msgstr "ຜູ້ໃຊ້ສາມາດເຫັນລາຍການຕ່າງໆໃນໂຟນເດີໄດ້, ແຕ່ບໍ່ສາມາດເປີດອັນໃດໄດ້ເລີຍ."

#. (itstool) path: varlistentry/term
#: C/goscaja.xml:2252
msgid "Access files"
msgstr "ເຂົ້າເຖິງໄຟລ໌"

#. (itstool) path: listitem/para
#: C/goscaja.xml:2254
msgid "Items in the folder can be opened and modified, provided their own permissions allow it."
msgstr ""
"ລາຍການໃນໂຟນເດີສາມາດເປີດ ແລະ ແກ້ໄຂໄດ້, ຖ້າການກຳນົດສິດຂອງລາຍການນັ້ນອະນຸຍາດ."

#. (itstool) path: varlistentry/term
#: C/goscaja.xml:2257
msgid "Create and delete files"
msgstr "ສ້າງ ແລະ ລຶບໄຟລ໌"

#. (itstool) path: listitem/para
#: C/goscaja.xml:2259
msgid "The user can create new files and delete files in the folder, in addition to being able to access existing files."
msgstr ""
"ຜູ້ໃຊ້ສາມາດສ້າງໄຟລ໌ໃໝ່ ແລະ ລຶບໄຟລ໌ໃນໂຟນເດີໄດ້, ນອກເໜືອຈາກການເຂົ້າເຖິງໄຟລ໌ທີ່ມີຢູ່ແລ້ວ."

#. (itstool) path: section/para
#: C/goscaja.xml:2266
msgid "To set permissions for all the items contained in a folder, set the <guilabel>File Access</guilabel> and <guilabel>Execute</guilabel> properties and click on <guibutton>Apply permissions to enclosed files</guibutton>."
msgstr ""
"ເພື່ອຕັ້ງການກຳນົດສິດໃຫ້ກັບທຸກລາຍການທີ່ຢູ່ໃນໂຟນເດີ, ໃຫ້ຕັ້ງຄຸນສົມບັດ <guilabel>ການເຂົ້າເຖິງໄຟລ໌</"
"guilabel> ແລະ <guilabel>ປະມວນຜົນ</guilabel> ແລ້ວຄລິກ <guibutton>ໃຊ້ການກຳນົດສິດກັບໄຟລ໌"
"ທີ່ຢູ່ພາຍໃນ</guibutton>."

#. (itstool) path: info/title
#: C/goscaja.xml:2271
msgid "Adding Notes to Files and Folders"
msgstr "ການເພີ່ມບັນທຶກໃສ່ໄຟລ໌ ແລະ ໂຟນເດີ"

#. (itstool) path: section/para
#: C/goscaja.xml:2272
msgid "You can add notes to files or folders. You can add notes to files or folders in the following ways:"
msgstr ""
"ເຈົ້າສາມາດເພີ່ມບັນທຶກໃສ່ໄຟລ໌ ຫຼື ໂຟນເດີໄດ້. ເຈົ້າສາມາດເພີ່ມບັນທຶກໄດ້ດ້ວຍວິທີດັ່ງຕໍ່ໄປນີ້:"

#. (itstool) path: listitem/para
#: C/goscaja.xml:2276
msgid "From the properties dialog"
msgstr "ຈາກໜ້າຕ່າງຄຸນສົມບັດ"

#. (itstool) path: listitem/para
#: C/goscaja.xml:2279
msgid "From <guilabel>Notes</guilabel> in the side pane"
msgstr "ຈາກ <guilabel>ບັນທຶກ</guilabel> ໃນແຖບຂ້າງ"

#. (itstool) path: info/title
#: C/goscaja.xml:2283
msgid "To Add a Note Using the Properties Dialog"
msgstr "ເພື່ອເພີ່ມບັນທຶກໂດຍໃຊ້ໜ້າຕ່າງຄຸນສົມບັດ"

#. (itstool) path: section/indexterm
#: C/goscaja.xml:2286
msgid "<primary>notes</primary> <secondary>adding to files and folders</secondary>"
msgstr ""
"<primary>ບັນທຶກ</primary> <secondary>ການເພີ່ມໃສ່ໄຟລ໌ ແລະ ໂຟນເດີ</secondary>"

#. (itstool) path: section/indexterm
#: C/goscaja.xml:2290
msgid "<primary>file manager</primary> <secondary>notes</secondary> <tertiary>adding</tertiary>"
msgstr ""
"<primary>ຕົວຈັດການໄຟລ໌</primary> <secondary>ບັນທຶກ</secondary> <tertiary>ການເພີ່ມ</"
"tertiary>"

#. (itstool) path: section/para
#: C/goscaja.xml:2295
#: C/goscaja.xml:2316
msgid "To add a note to a file or folder, perform the following steps:"
msgstr "ເພື່ອເພີ່ມບັນທຶກໃສ່ໄຟລ໌ ຫຼື ໂຟນເດີ, ໃຫ້ເຮັດຕາມຂັ້ນຕອນດັ່ງນີ້:"

#. (itstool) path: listitem/para
#: C/goscaja.xml:2299
msgid "Select the file or folder to which you want to add a note."
msgstr "ເລືອກໄຟລ໌ ຫຼື ໂຟນເດີທີ່ເຈົ້າຕ້ອງການເພີ່ມບັນທຶກ."

#. (itstool) path: listitem/para
#: C/goscaja.xml:2305
msgid "Click on the <guilabel>Notes</guilabel> tab. In the <guilabel>Notes</guilabel> tabbed section, type the note."
msgstr ""
"ຄລິກໃສ່ແທັບ <guilabel>ບັນທຶກ</guilabel>. ໃນສ່ວນຂອງແທັບ <guilabel>ບັນທຶກ</guilabel>, ໃຫ້"
"ພິມຂໍ້ຄວາມບັນທຶກ."

#. (itstool) path: listitem/para
#: C/goscaja.xml:2308
msgid "Click <guibutton>Close</guibutton> to close the properties dialog. A note emblem is added to the file or folder."
msgstr ""
"ຄລິກ <guibutton>ປິດ</guibutton> ເພື່ອປິດໜ້າຕ່າງຄຸນສົມບັດ. ສັນຍະລັກບັນທຶກຈະຖືກເພີ່ມໃສ່ໄຟລ໌ ຫຼື ໂຟນເ"
"ດີນັ້ນ."

#. (itstool) path: para/indexterm
#: C/goscaja.xml:2312
msgid "<primary>notes</primary><secondary>deleting</secondary>"
msgstr "<primary>ບັນທຶກ</primary><secondary>ການລຶບ</secondary>"

#. (itstool) path: para/indexterm
#: C/goscaja.xml:2312
msgid "<primary>file manager</primary><secondary>notes</secondary><tertiary>deleting</tertiary>"
msgstr ""
"<primary>ຕົວຈັດການໄຟລ໌</primary><secondary>ບັນທຶກ</secondary><tertiary>ການລຶບ</"
"tertiary>"

#. (itstool) path: section/para
#: C/goscaja.xml:2312
msgid "<_:indexterm-1/><_:indexterm-2/>To delete a note, delete the note text from the <guilabel>Notes</guilabel> tabbed section."
msgstr ""
"<_:indexterm-1/><_:indexterm-2/>ເພື່ອລຶບບັນທຶກ, ໃຫ້ລຶບຂໍ້ຄວາມບັນທຶກອອກຈາກສ່ວນແທັບ "
"<guilabel>ບັນທຶກ</guilabel>."

#. (itstool) path: info/title
#: C/goscaja.xml:2314
msgid "To Add a Note Using Notes in the Side Pane"
msgstr "ເພື່ອເພີ່ມບັນທຶກໂດຍໃຊ້ສ່ວນບັນທຶກໃນແຖບຂ້າງ"

#. (itstool) path: listitem/para
#: C/goscaja.xml:2319
msgid "Open the file or folder to which you want to add a note in the view pane."
msgstr "ເປີດໄຟລ໌ ຫຼື ໂຟນເດີທີ່ເຈົ້າຕ້ອງການເພີ່ມບັນທຶກໃນສ່ວນສະແດງຜົນ."

#. (itstool) path: listitem/para
#: C/goscaja.xml:2323
msgid "Choose <guilabel>Notes</guilabel> from the drop-down list at the top of the side pane. To display the side pane, choose <menuchoice><guimenu>View</guimenu><guimenuitem>Side Pane</guimenuitem></menuchoice>."
msgstr ""
"ເລືອກ <guilabel>ບັນທຶກ</guilabel> ຈາກລາຍການເລືອກຢູ່ເທິງສຸດຂອງແຖບຂ້າງ. ເພື່ອສະແດງແຖບຂ້າງ, "
"ໃຫ້ເລືອກ <menuchoice><guimenu>ວິວ</guimenu><guimenuitem>ແຖບຂ້າງ</guimenuitem></"
"menuchoice>."

#. (itstool) path: listitem/para
#: C/goscaja.xml:2327
msgid "Type the note in the side pane. A note emblem is added to the file or folder in the view pane, and a note icon is added to the side pane. You can click on this icon to display the note."
msgstr ""
"ພິມບັນທຶກໃນແຖບຂ້າງ. ສັນຍະລັກບັນທຶກຈະຖືກເພີ່ມໃສ່ໄຟລ໌ ຫຼື ໂຟນເດີໃນສ່ວນສະແດງຜົນ, ແລະ ໄອຄອນບັນທຶກຈະຖືກ"
"ເພີ່ມໃສ່ແຖບຂ້າງ. ເຈົ້າສາມາດຄລິກໃສ່ໄອຄອນນີ້ເພື່ອສະແດງບັນທຶກໄດ້."

#. (itstool) path: section/para
#: C/goscaja.xml:2332
msgid "To delete a note, delete the note text from <guilabel>Notes</guilabel> in the side pane."
msgstr ""
"ເພື່ອລຶບບັນທຶກ, ໃຫ້ລຶບຂໍ້ຄວາມບັນທຶກອອກຈາກ <guilabel>ບັນທຶກ</guilabel> ໃນແຖບຂ້າງ."

#. (itstool) path: info/title
#: C/goscaja.xml:2337
msgid "Using Bookmarks For Your Favorite Locations"
msgstr "ການໃຊ້ບຸກມາກ (Bookmarks) ສຳລັບຕຳແໜ່ງທີ່ເຈົ້າມັກ"

#. (itstool) path: section/indexterm
#: C/goscaja.xml:2341
msgid "<primary>file manager</primary> <secondary>bookmarks</secondary>"
msgstr "<primary>ຕົວຈັດການໄຟລ໌</primary> <secondary>ບຸກມາກ</secondary>"

#. (itstool) path: section/para
#: C/goscaja.xml:2345
msgid "You can keep a list of <firstterm>bookmarks</firstterm> in <application>Caja</application>: folders and other locations that you frequently need to open."
msgstr ""
"ເຈົ້າສາມາດເກັບລາຍຊື່ <firstterm>ບຸກມາກ</firstterm> ໄວ້ໃນ <application>Caja</"
"application> ໄດ້: ເຊິ່ງກໍຄືໂຟນເດີ ແລະ ຕຳແໜ່ງອື່ນໆທີ່ເຈົ້າຕ້ອງການເປີດເລື້ອຍໆ."

#. (itstool) path: section/para
#: C/goscaja.xml:2346
msgid "Your bookmarks are listed in the following places:"
msgstr "ບຸກມາກຂອງເຈົ້າຈະຖືກສະແດງຢູ່ໃນບ່ອນຕ່າງໆດັ່ງນີ້:"

#. (itstool) path: listitem/para
#: C/goscaja.xml:2348
msgid "The <guimenu>Places</guimenu> menu on the top panel."
msgstr "ເມນູ <guimenu>ຕຳແໜ່ງ</guimenu> ຢູ່ແຖບດ້ານເທິງ."

#. (itstool) path: listitem/para
#: C/goscaja.xml:2349
msgid "The <guimenu>Places</guimenu> menu in a folder window."
msgstr "ເມນູ <guimenu>ຕຳແໜ່ງ</guimenu> ໃນໜ້າຕ່າງໂຟນເດີ."

#. (itstool) path: listitem/para
#: C/goscaja.xml:2350
msgid "The <guimenu>Bookmarks</guimenu> menu in a <application>Caja</application> browser window."
msgstr ""
"ເມນູ <guimenu>ບຸກມາກ</guimenu> ໃນໜ້າຕ່າງບຣາວເຊີ <application>Caja</application>."

#. (itstool) path: listitem/para
#: C/goscaja.xml:2351
msgid "The side pane in the <xref linkend=\"filechooser-open\"/>. This allows you to quickly open a file that is in one of your bookmarked locations."
msgstr ""
"ແຖບຂ້າງໃນ <xref linkend=\"filechooser-open\"/>. ສິ່ງນີ້ຊ່ວຍໃຫ້ເຈົ້າເປີດໄຟລ໌ທີ່ຢູ່ໃນຕຳແໜ່ງບຸກມາ"
"ກໄດ້ຢ່າງວ່ອງໄວ."

#. (itstool) path: listitem/para
#: C/goscaja.xml:2352
msgid "The list of commonly used locations in the <xref linkend=\"filechooser-save\"/>. This allows you to quickly save a file to a location you have in your bookmarks."
msgstr ""
"ລາຍຊື່ຕຳແໜ່ງທີ່ໃຊ້ເລື້ອຍໆໃນ <xref linkend=\"filechooser-save\"/>. ສິ່ງນີ້ຊ່ວຍໃຫ້ເຈົ້າບັນທຶກໄຟລ໌ລົ"
"ງໃນຕຳແໜ່ງທີ່ຢູ່ໃນບຸກມາກໄດ້ຢ່າງວ່ອງໄວ."

#. (itstool) path: section/para
#: C/goscaja.xml:2355
msgid "To open an item that is in your bookmarks, choose the item from a menu."
msgstr "ເພື່ອເປີດລາຍການທີ່ຢູ່ໃນບຸກມາກ, ໃຫ້ເລືອກລາຍການນັ້ນຈາກເມນູ."

#. (itstool) path: info/title
#: C/goscaja.xml:2357
msgid "Adding a Bookmark"
msgstr "ການເພີ່ມບຸກມາກ"

#. (itstool) path: section/para
#: C/goscaja.xml:2358
msgid "To add a bookmark, open the folder or location that you want to bookmark, then choose <menuchoice><guimenu>Places</guimenu><guimenuitem>Add Bookmark</guimenuitem></menuchoice>."
msgstr ""
"ເພື່ອເພີ່ມບຸກມາກ, ໃຫ້ເປີດໂຟນເດີ ຫຼື ຕຳແໜ່ງທີ່ເຈົ້າຕ້ອງການເຮັດບຸກມາກ, ຈາກນັ້ນເລືອກ <menuchoice>"
"<guimenu>ຕຳແໜ່ງ</guimenu><guimenuitem>ເພີ່ມບຸກມາກ</guimenuitem></menuchoice>."

#. (itstool) path: section/para
#: C/goscaja.xml:2359
msgid "If you are using a <application>Caja</application> browser window, choose <menuchoice><guimenu>Bookmarks</guimenu><guimenuitem>Add Bookmark</guimenuitem></menuchoice>."
msgstr ""
"ຫາກເຈົ້າກຳລັງໃຊ້ໜ້າຕ່າງບຣາວເຊີ <application>Caja</application>, ໃຫ້ເລືອກ <menuchoice>"
"<guimenu>ບຸກມາກ</guimenu><guimenuitem>ເພີ່ມບຸກມາກ</guimenuitem></menuchoice>."

#. (itstool) path: info/title
#: C/goscaja.xml:2362
msgid "To Edit a Bookmark"
msgstr "ເພື່ອແກ້ໄຂບຸກມາກ"

#. (itstool) path: section/para
#: C/goscaja.xml:2363
msgid "To edit your bookmarks perform the following steps:"
msgstr "ເພື່ອແກ້ໄຂບຸກມາກຂອງເຈົ້າ, ໃຫ້ເຮັດຕາມຂັ້ນຕອນດັ່ງນີ້:"

#. (itstool) path: listitem/para
#: C/goscaja.xml:2366
msgid "Choose <menuchoice><guimenu>Places</guimenu><guimenuitem>Edit Bookmarks</guimenuitem></menuchoice>, or in a browser window, <menuchoice><guimenu>Bookmarks</guimenu><guimenuitem>Edit Bookmarks</guimenuitem></menuchoice>. An <guilabel>Edit Bookmarks</guilabel> dialog is displayed."
msgstr ""

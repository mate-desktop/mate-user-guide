#. (itstool) path: section/indexterm
#: C/goscustdesk.xml:107
msgid "<primary>keyboard shortcuts</primary> <secondary>configuring</secondary>"
msgstr "<primary>ປຸ່ມລັດຄີບອດ</primary> <secondary>ການຕັ້ງຄ່າ</secondary>"

#. (itstool) path: section/para
#: C/goscustdesk.xml:111
msgid "Use the <application>Keyboard Shortcuts</application> preference tool to customize the default keyboard shortcuts to your requirements."
msgstr ""
"ໃຊ້ເຄື່ອງມືການຕັ້ງຄ່າ <application>ປຸ່ມລັດຄີບອດ</application> ເພື່ອປັບແຕ່ງ ປຸ່ມລັດຄີບອດເລີ່ມຕົ້ນໃຫ້ກົງ"
"ກັບຄວາມຕ້ອງການຂອງທ່ານ."

#. (itstool) path: section/para
#: C/goscustdesk.xml:113
msgid "A <firstterm>keyboard shortcut</firstterm> is a key or combination of keys that provides an alternative to standard ways of performing an action. For more on keyboard shortcuts, and a list of the default shortcuts in MATE, see <xref linkend=\"keyboard-skills\"/>."
msgstr ""
"<firstterm>ປຸ່ມລັດຄີບອດ</firstterm> ແມ່ນປຸ່ມ ຫຼື ການກົດຫຼາຍປຸ່ມພ້ອມກັນ ເຊິ່ງເປັນທາງເລືອກໃນການປະຕິ"
"ບັດງານແທນວິທີມາດຕະຖານ. ສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບປຸ່ມລັດ, ແລະ ລາຍຊື່ປຸ່ມລັດເລີ່ມຕົ້ນໃນ MATE, ເບິ່ງ "
"<xref linkend=\"keyboard-skills\"/>."

#. (itstool) path: section/para
#: C/goscustdesk.xml:116
msgid "To edit a keyboard shortcut, perform the following steps:"
msgstr "ເພື່ອແກ້ໄຂປຸ່ມລັດຄີບອດ, ໃຫ້ປະຕິບັດຕາມຂັ້ນຕອນດັ່ງນີ້:"

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:118
msgid "Double-click on the shortcut that you want to edit. If you are using the keyboard, use the arrow keys to select the shortcut and press <keycap>Return</keycap>."
msgstr ""
"ດັບເບິລຄລິກໃສ່ປຸ່ມລັດທີ່ທ່ານຕ້ອງການແກ້ໄຂ. ຫາກທ່ານໃຊ້ຄີບອດ, ໃຫ້ໃຊ້ປຸ່ມລູກສອນ ເພື່ອເລືອກປຸ່ມລັດແລ້ວກົດ "
"<keycap>Return</keycap> (ຫຼື Enter)."

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:121
msgid "Press the new key or key combination you want to assign to the action."
msgstr "ກົດປຸ່ມໃໝ່ ຫຼື ກຸ່ມປຸ່ມທີ່ທ່ານຕ້ອງການກຳນົດໃຫ້ກັບການກະທຳນັ້ນ."

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:122
msgid "To clear a shortcut, press <keycap>Backspace</keycap>. The action is now marked as <guilabel>Disabled</guilabel>."
msgstr ""
"ເພື່ອລຶບປຸ່ມລັດ, ໃຫ້ກົດ <keycap>Backspace</keycap>. ຕອນນີ້ການກະທໍານັ້ນ ຈະຖືກໝາຍເປັນ "
"<guilabel>ປິດໃຊ້ງານ</guilabel>."

#. (itstool) path: section/para
#: C/goscustdesk.xml:126
msgid "To cancel assigning a shortcut, click elsewhere in the window or press <keycap>Escape</keycap>."
msgstr ""
"ເພື່ອຍົກເລີກການກຳນົດປຸ່ມລັດ, ໃຫ້ຄລິກບ່ອນອື່ນໃນໜ້າຕ່າງ ຫຼື ກົດ <keycap>Escape</keycap>."

#. (itstool) path: section/para
#: C/goscustdesk.xml:128
msgid "The shortcuts you can customize are grouped as follows:"
msgstr "ປຸ່ມລັດທີ່ທ່ານສາມາດປັບແຕ່ງໄດ້ຖືກຈັດກຸ່ມໄວ້ດັ່ງນີ້:"

#. (itstool) path: varlistentry/term
#: C/goscustdesk.xml:131
#: C/gosoverview.xml:49
msgid "Desktop"
msgstr "ເດດທັອບ"

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:132
msgid "These are general shortcuts for the whole desktop, such as logging out, locking your screen (see <xref linkend=\"lock-screen\"/>), opening the panel menubar (see <xref linkend=\"menubar\"/>), or launching a web browser."
msgstr ""
"ເຫຼົ່ານີ້ແມ່ນປຸ່ມລັດທົ່ວໄປສຳລັບເດັສທັອບທັງໝົດ ເຊັ່ນ ການອອກຈາກລະບົບ, ການລັອກໜ້າຈໍ (ເບິ່ງ <xref "
"linkend=\"lock-screen\"/>), ການເປີດແຖບເມນູຂອງແຜງ (ເບິ່ງ <xref "
"linkend=\"menubar\"/>), ຫຼື ການເປີດເວັບບຣາວເຊີ."

#. (itstool) path: varlistentry/term
#: C/goscustdesk.xml:134
msgid "Sound"
msgstr "ສຽງ"

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:135
msgid "Shortcuts for controlling your music player and the system volume."
msgstr "ປຸ່ມລັດສຳລັບຄວບຄຸມເຄື່ອງຫຼິ້ນເພງ ແລະ ລະດັບສຽງຂອງລະບົບ."

#. (itstool) path: varlistentry/term
#: C/goscustdesk.xml:137
msgid "Window Management"
msgstr "ການຈັດການໜ້າຕ່າງ"

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:138
msgid "Shortcuts for working with windows and workspaces, such as maximizing or moving the current window, and switching to another workspace. For more information on these kinds of actions, see <xref linkend=\"windows-manipulating\"/> and <xref linkend=\"overview-workspaces\"/>."
msgstr ""
"ປຸ່ມລັດສຳລັບການເຮັດວຽກກັບໜ້າຕ່າງ ແລະ ພື້ນທີ່ເຮັດວຽກ ເຊັ່ນ ການຂະຫຍາຍ ຫຼື ຍ້າຍ ໜ້າຕ່າງປັດຈຸບັນ, ແລະ ກາ"
"ນສະຫຼັບໄປຍັງພື້ນທີ່ເຮັດວຽກອື່ນ. ສຳລັບຂໍ້ມູນເພີ່ມເຕີມ, ເບິ່ງ <xref linkend=\"windows-"
"manipulating\"/> ແລະ <xref linkend=\"overview-workspaces\"/>."

#. (itstool) path: varlistentry/term
#: C/goscustdesk.xml:140
msgid "Accessibility"
msgstr "ການເຂົ້າເຖິງ"

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:141
msgid "Shortcuts for starting assistive technologies, such as a screen reader, a magnifier or an on-screen keyboard."
msgstr ""
"ປຸ່ມລັດສຳລັບເລີ່ມຕົ້ນເຕັກໂນໂລຊີຊ່ວຍເຫຼືອ ເຊັ່ນ ຕົວອ່ານໜ້າຈໍ, ແວ່ນຂະຫຍາຍ ຫຼື ຄີບອດເທິງໜ້າຈໍ."

#. (itstool) path: varlistentry/term
#: C/goscustdesk.xml:144
msgid "Custom Shortcuts"
msgstr "ປຸ່ມລັດທີ່ກຳນົດເອງ"

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:145
msgid "Custom shortcuts that have been added with the <guilabel>Add</guilabel> button. This section will not be shown if there are no custom shortcuts."
msgstr ""
"ປຸ່ມລັດທີ່ກຳນົດເອງເຊິ່ງຖືກເພີ່ມດ້ວຍປຸ່ມ <guilabel>ເພີ່ມ</guilabel>. ພາກສ່ວນນີ້ຈະບໍ່ສະແດງຂຶ້ນຫາກບໍ່ມີປຸ່ມລັ"
"ດທີ່ກຳນົດເອງ."

#. (itstool) path: section/para
#: C/goscustdesk.xml:148
msgid "To add a custom shortcut, use the <guilabel>Add</guilabel> button in the action area. You have to provide a name and a command for the new shortcut. The new custom shortcut will appear in the list of shortcuts and can be edited in the same way as the predefined shortcuts."
msgstr ""
"ເພື່ອເພີ່ມປຸ່ມລັດທີ່ກຳນົດເອງ, ໃຫ້ໃຊ້ປຸ່ມ <guilabel>ເພີ່ມ</guilabel> ໃນພື້ນທີ່ການກະທຳ. ທ່ານຕ້ອງຕັ້ງຊື່ ແ"
"ລະ ໃສ່ຄຳສັ່ງສຳລັບປຸ່ມລັດໃໝ່. ປຸ່ມລັດໃໝ່ນີ້ຈະປາກົດໃນລາຍຊື່ ແລະ ສາມາດແກ້ໄຂໄດ້ຄືກັນກັບປຸ່ມລັດທີ່ມີມາກັບລະບົບ."

#. (itstool) path: section/para
#: C/goscustdesk.xml:151
msgid "To remove a custom shortcut, use the <guilabel>Remove</guilabel> button."
msgstr "ເພື່ອລຶບປຸ່ມລັດທີ່ກຳນົດເອງ, ໃຫ້ໃຊ້ປຸ່ມ <guilabel>ລຶບອອກ</guilabel>."

#. (itstool) path: info/title
#: C/goscustdesk.xml:156
msgid "Preferred Applications"
msgstr "ແອັບພລິເຄຊັນທີ່ຕ້ອງການ"

#. (itstool) path: section/indexterm
#: C/goscustdesk.xml:159
msgid "<primary>preference tools</primary> <secondary>Preferred Applications</secondary>"
msgstr ""
"<primary>ເຄື່ອງມືການຕັ້ງຄ່າ</primary> <secondary>ແອັບພລິເຄຊັນທີ່ຕ້ອງການ</secondary>"

#. (itstool) path: section/indexterm
#: C/goscustdesk.xml:163
msgid "<primary>default applications</primary> <see>preferred applications</see>"
msgstr ""
"<primary>ແອັບພລິເຄຊັນເລີ່ມຕົ້ນ</primary> <see>ແອັບພລິເຄຊັນທີ່ຕ້ອງການ</see>"

#. (itstool) path: section/para
#: C/goscustdesk.xml:167
msgid "Use the <application>Preferred Applications</application> preference tool to specify the applications that you want the MATE Desktop to use when the MATE Desktop starts an application for you. For example, you can specify the web browser application (<application>Epiphany</application>, <application>Mozilla Firefox</application>, <application>Opera</application>...) to launch when you click on a link in other applications such as email clients or document viewers."
msgstr ""
"ໃຊ້ເຄື່ອງມືການຕັ້ງຄ່າ <application>ແອັບພລິເຄຊັນທີ່ຕ້ອງການ</application> ເພື່ອລະບຸ ແອັບພລິເຄຊັນທີ່ທ່"
"ານຕ້ອງການໃຫ້ເດັສທັອບ MATE ໃຊ້. ຕົວຢ່າງ, ທ່ານສາມາດລະບຸ ເວັບບຣາວເຊີ (<application>"
"Epiphany</application>, <application>Mozilla Firefox</application>, "
"<application>Opera</application>...) ໃຫ້ເປີດຂຶ້ນເມື່ອທ່ານຄລິກໃສ່ລິ້ງໃນແອັບພລິເຄຊັນອື່ນ ເຊິ່ງລວມ"
"ມີ ແອັບພລິເຄຊັນອີເມລ ຫຼື ຕົວເບິ່ງເອກະສານ."

#. (itstool) path: section/para
#: C/goscustdesk.xml:173
msgid "<application>Preferred Applications</application> can be found by going to <menuchoice><guimenu>System</guimenu><guisubmenu>Preferences</guisubmenu><guisubmenu>Personal</guisubmenu><guimenuitem>Preferred Applications</guimenuitem></menuchoice>."
msgstr ""
"ທ່ານສາມາດຊອກຫາ <application>ແອັບພລິເຄຊັນທີ່ຕ້ອງການ</application> ໄດ້ໂດຍການໄປທີ່ "
"<menuchoice><guimenu>ລະບົບ</guimenu><guisubmenu>ການຕັ້ງຄ່າ</guisubmenu>"
"<guisubmenu>ສ່ວນຕົວ</guisubmenu><guimenuitem>ແອັບພລິເຄຊັນທີ່ຕ້ອງການ</guimenuitem></"
"menuchoice>."

#. (itstool) path: section/para
#: C/goscustdesk.xml:175
msgid "You can customize the preferences for the <application>Preferred Applications</application> preference tool in the following functional areas."
msgstr ""
"ທ່ານສາມາດປັບແຕ່ງການຕັ້ງຄ່າສຳລັບເຄື່ອງມື <application>ແອັບພລິເຄຊັນທີ່ຕ້ອງການ</application> ໃນໝ"
"ວດໝູ່ການເຮັດວຽກຕໍ່ໄປນີ້."

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:178
msgid "<guilabel>Internet</guilabel> (Web Browser, Mail Reader)"
msgstr "<guilabel>ອິນເຕີເນັດ</guilabel> (ເວັບບຣາວເຊີ, ຕົວອ່ານອີເມລ)"

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:183
msgid "<guilabel>Multimedia</guilabel> (Image Viewer, Multimedia Player, Video Player)"
msgstr ""
"<guilabel>ມັລຕິມີເດຍ</guilabel> (ຕົວເບິ່ງຮູບພາບ, ເຄື່ອງຫຼິ້ນມັລຕິມີເດຍ, ເຄື່ອງຫຼິ້ນວິດີໂອ)"


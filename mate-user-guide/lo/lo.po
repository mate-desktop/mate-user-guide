#. (itstool) path: entry/para
#: C/goscaja.xml:1238
msgid "<guilabel>By Name</guilabel>"
msgstr "<guilabel>ຕາມຊື່</guilabel>"

#. (itstool) path: entry/para
#: C/goscaja.xml:1243
msgid "Select this option to sort the items alphabetically by name. The order of the items is not case-sensitive. If the file manager is set to display hidden files, the hidden files are shown last."
msgstr ""
"ເລືອກຕົວເລືອກນີ້ເພື່ອຄັດລຽງລາຍການຕາມລຳດັບຕົວອັກສອນຂອງຊື່. ລຳດັບຂອງລາຍການຈະບໍ່ຈຳແນກຕົວອັກສອນໃຫຍ່-"
"ນ້ອຍ. ຖ້າຕົວຈັດການໄຟລ໌ຖືກຕັ້ງຄ່າໃຫ້ສະແດງໄຟລ໌ທີ່ຊ້ອນຢູ່, ໄຟລ໌ທີ່ຊ້ອນຢູ່ຈະຖືກສະແດງເປັນອັນດັບສຸດທ້າຍ."

#. (itstool) path: entry/para
#: C/goscaja.xml:1251
msgid "<guilabel>By Size</guilabel>"
msgstr "<guilabel>ຕາມຂະໜາດ</guilabel>"

#. (itstool) path: entry/para
#: C/goscaja.xml:1256
msgid "Select this option to sort the items by size, with the largest item first. When you sort items by size, the folders are sorted by the number of items in the folder. The folders are not sorted by the total size of the items in the folder."
msgstr ""
"ເລືອກຕົວເລືອກນີ້ເພື່ອຄັດລຽງລາຍການຕາມຂະໜາດ, ໂດຍໃຫ້ລາຍການທີ່ມີຂະໜາດໃຫຍ່ທີ່ສຸດຂຶ້ນກ່ອນ. ເມື່ອທ່ານຄັດລຽງ"
"ລາຍການຕາມຂະໜາດ, ໂຟນເດີຈະຖືກຄັດລຽງຕາມຈຳນວນລາຍການທີ່ມີຢູ່ໃນໂຟນເດີ. ໂຟນເດີຈະບໍ່ໄດ້ຖືກຄັດລຽງຕາມຂ"
"ະໜາດລວມຂອງໄຟລ໌ທັງໝົດໃນໂຟນເດີ."

#. (itstool) path: entry/para
#: C/goscaja.xml:1264
msgid "<guilabel>By Type</guilabel>"
msgstr "<guilabel>ຕາມປະເພດ</guilabel>"

#. (itstool) path: entry/para
#: C/goscaja.xml:1269
msgid "Select this option to sort the items alphabetically by object type. The items are sorted alphabetically by the description of their <firstterm>MIME type</firstterm>. The MIME type identifies the format of a file, and enables applications to read the file. For example, an email application can use the <literal>image/png</literal> MIME type to detect that a PNG file is attached to an email."
msgstr ""
"ເລືອກຕົວເລືອກນີ້ເພື່ອຄັດລຽງລາຍການຕາມລຳດັບຕົວອັກສອນຂອງປະເພດວັດຖຸ. ລາຍການຕ່າງໆຈະຖືກຄັດລຽງຕາມຄຳອ"
"ະທິບາຍຂອງ <firstterm>ປະເພດ MIME</firstterm> ຂອງພວກມັນ. ປະເພດ MIME ຈະລະບຸຮູບແບບຂອງ"
"ໄຟລ໌ ແລະ ຊ່ວຍໃຫ້ແອັບພລິເຄຊັນສາມາດອ່ານໄຟລ໌ໄດ້. ຕົວຢ່າງ: ແອັບພລິເຄຊັນອີເມລສາມາດໃຊ້ປະເພດ MIME "
"<literal>image/png</literal> ເພື່ອກວດສອບວ່າໄຟລ໌ PNG ຖືກແນບມາກັບອີເມລ."

#. (itstool) path: entry/para
#: C/goscaja.xml:1279
msgid "<guilabel>By Modification Date</guilabel>"
msgstr "<guilabel>ຕາມວັນທີແກ້ໄຂ</guilabel>"

#. (itstool) path: entry/para
#: C/goscaja.xml:1284
msgid "Select this option to sort the items by the date the items were last modified. The most recently modified item is first."
msgstr ""
"ເລືອກຕົວເລືອກນີ້ເພື່ອຄັດລຽງລາຍການຕາມວັນທີທີ່ລາຍການນັ້ນຖືກແກ້ໄຂຫຼ້າສຸດ. ລາຍການທີ່ຫາກໍ່ຖືກແກ້ໄຂຫຼ້າສຸດຈະຂຶ້ນກ່"
"ອນ."

#. (itstool) path: entry/para
#: C/goscaja.xml:1290
msgid "<guilabel>By Emblems</guilabel>"
msgstr "<guilabel>ຕາມສັນຍະລັກ</guilabel>"

#. (itstool) path: entry/para
#: C/goscaja.xml:1295
msgid "Select this option to sort the items by any emblems that are added to the items. The items are sorted alphabetically by emblem name. Items that do not have emblems are last."
msgstr ""
"ເລືອກຕົວເລືອກນີ້ເພື່ອຄັດລຽງລາຍການຕາມສັນຍະລັກທີ່ເພີ່ມໃສ່ລາຍການນັ້ນ. ລາຍການຕ່າງໆຈະຖືກຄັດລຽງຕາມລຳດັບຕົ"
"ວອັກສອນຂອງຊື່ສັນຍະລັກ. ລາຍການທີ່ບໍ່ມີສັນຍະລັກຈະຢູ່ເປັນອັນດັບສຸດທ້າຍ."

#. (itstool) path: entry/para
#: C/goscaja.xml:1302
msgid "<guilabel>Compact Layout</guilabel>"
msgstr "<guilabel>ການຈັດວາງແບບກະທັດຮັດ</guilabel>"

#. (itstool) path: entry/para
#: C/goscaja.xml:1307
msgid "Select this option to arrange the items so that the items are closer to each other."
msgstr "ເລືອກຕົວເລືອກນີ້ເພື່ອຈັດວາງລາຍການຕ່າງໆໃຫ້ຢູ່ໃກ້ຊິດກັນຫຼາຍຂຶ້ນ."

#. (itstool) path: entry/para
#: C/goscaja.xml:1313
msgid "<guilabel>Reversed Order</guilabel>"
msgstr "<guilabel>ຄັດລຽງແບບຍ້ອນກັບ</guilabel>"

#. (itstool) path: entry/para
#: C/goscaja.xml:1318
msgid "Select this option to reverse the order of the option by which you sort the items. For example, if you sort the items by name, select the <guilabel>Reversed Order</guilabel> option to sort the items in reverse alphabetical order."
msgstr ""
"ເລືອກຕົວເລືອກນີ້ເພື່ອປີ້ນລຳດັບຂອງຕົວເລືອກທີ່ທ່ານໃຊ້ຄັດລຽງລາຍການ. ຕົວຢ່າງ: ຖ້າທ່ານຄັດລຽງລາຍການຕາມຊື່, "
"ໃຫ້ເລືອກຕົວເລືອກ <guilabel>ຄັດລຽງແບບຍ້ອນກັບ</guilabel> ເພື່ອຄັດລຽງລາຍການຕາມລຳດັບຕົວອັກສອນຈ"
"າກທ້າຍຫາຕົ້ນ."

#. (itstool) path: info/title
#: C/goscaja.xml:1329
msgid "To Arrange Your Files in List View"
msgstr "ການຈັດວາງໄຟລ໌ຂອງທ່ານໃນມຸມມອງລາຍຊື່"

#. (itstool) path: section/indexterm
#: C/goscaja.xml:1330
msgid "<primary>file manager</primary> <secondary>list view</secondary> <tertiary>arranging files in</tertiary>"
msgstr ""
"<primary>ຕົວຈັດການໄຟລ໌</primary> <secondary>ມຸມມອງລາຍຊື່</secondary> <tertiary>ການຈັ"
"ດວາງໄຟລ໌</tertiary>"

#. (itstool) path: section/para
#: C/goscaja.xml:1335
msgid "When you display the contents of a folder in list view, you can specify how to arrange the items in the folder. To specify how to arrange items in list view, click on the header of the column specifying the property by which you wish to arrange the items. To inverse the sorting order click on the same column header again."
msgstr ""
"ເມື່ອທ່ານສະແດງເນື້ອໃນຂອງໂຟນເດີໃນມຸມມອງລາຍຊື່, ທ່ານສາມາດລະບຸວິທີການຈັດວາງລາຍການໃນໂຟນເດີໄດ້. ເພື່"
"ອລະບຸວິທີການຈັດວາງລາຍການໃນມຸມມອງລາຍຊື່, ໃຫ້ຄລິກໃສ່ສ່ວນຫົວຂອງຄໍລຳທີ່ລະບຸຄຸນສົມບັດທີ່ທ່ານຕ້ອງການໃຊ້ຈັດວາ"
"ງລາຍການ. ເພື່ອປີ້ນລຳດັບການຄັດລຽງ ໃຫ້ຄລິກໃສ່ສ່ວນຫົວຂອງຄໍລຳເດີມນັ້ນອີກຄັ້ງ."

#. (itstool) path: section/para
#: C/goscaja.xml:1338
msgid "To add or remove columns from the list view choose <menuchoice><guimenu>View</guimenu><guisubmenu>Visible Columns</guisubmenu></menuchoice>"
msgstr ""
"ເພື່ອເພີ່ມ ຫຼື ລຶບຖັນອອກຈາກມຸມມອງລາຍການ ໃຫ້ເລືອກ <menuchoice><guimenu>ວິວ</guimenu>"
"<guisubmenu>ຖັນທີ່ສະແດງ</guisubmenu></menuchoice>"

#. (itstool) path: section/para
#: C/goscaja.xml:1339
msgid "The file manager remembers how you arrange the items in a particular folder. The next time that you display the folder, the items are arranged in the way that you selected. In other words, when you specify how to arrange the items in a folder, you customize the folder to display the items in that way. To return the arrangement settings of the folder to the default arrangement settings specified in your preferences, choose <menuchoice><guimenu>View</guimenu><guimenuitem>Reset View to Defaults</guimenuitem></menuchoice>."
msgstr ""
"ຕົວຈັດການໄຟລ໌ຈະຈົດຈຳວິທີທີ່ເຈົ້າຈັດລຽງລາຍການໃນໂຟນເດີໃດໜຶ່ງ. ໃນຄັ້ງຕໍ່ໄປທີ່ເຈົ້າເປີດໂຟນເດີນັ້ນ, ລາຍການຕ່າ"
"ງໆຈະຖືກຈັດລຽງຕາມແບບທີ່ເຈົ້າໄດ້ເລືອກໄວ້. ເວົ້າອີກຢ່າງໜຶ່ງແມ່ນ ເມື່ອເຈົ້າກຳນົດວິທີຈັດລຽງລາຍການໃນໂຟນເດີ, "
"ເຈົ້າກຳລັງປັບແຕ່ງໂຟນເດີໃຫ້ສະແດງລາຍການໃນຮູບແບບນັ້ນ. ເພື່ອຄືນຄ່າການຈັດລຽງຂອງໂຟນເດີໃຫ້ເປັນຄ່າເລີ່ມຕົ້ນຕ"
"າມທີ່ກຳນົດໄວ້ໃນການຕັ້ງຄ່າ, ໃຫ້ເລືອກ <menuchoice><guimenu>ວິວ</guimenu><guimenuitem>ຕັ້ງຄ່າ"
"ການເບິ່ງເປັນຄ່າເລີ່ມຕົ້ນ</guimenuitem></menuchoice>."

#. (itstool) path: info/title
#: C/goscaja.xml:1347
msgid "To Change the Size of Items in a View"
msgstr "ເພື່ອປ່ຽນຂະໜາດຂອງລາຍການໃນມຸມມອງ"

#. (itstool) path: section/indexterm
#: C/goscaja.xml:1348
msgid "<primary>file manager</primary> <secondary>zooming in and out</secondary>"
msgstr ""
"<primary>ຕົວຈັດການໄຟລ໌</primary> <secondary>ການຂະຫຍາຍ ແລະ ຫຍໍ້</secondary>"

#. (itstool) path: section/para
#: C/goscaja.xml:1352
msgid "You can change the size of items in a view. You can change the size if the view displays a file or a folder. You can change the size of items in a view in the following ways:"
msgstr ""
"ເຈົ້າສາມາດປ່ຽນຂະໜາດຂອງລາຍການໃນມຸມມອງໄດ້. ເຈົ້າສາມາດປ່ຽນຂະໜາດໄດ້ບໍ່ວ່າຈະເປັນການສະແດງໄຟລ໌ ຫຼື ໂ"
"ຟນເດີ. ເຈົ້າສາມາດປ່ຽນຂະໜາດຂອງລາຍການໃນມຸມມອງໄດ້ດ້ວຍວິທີດັ່ງຕໍ່ໄປນີ້:"

#. (itstool) path: listitem/para
#: C/goscaja.xml:1357
msgid "To enlarge the size of items in a view, choose <menuchoice><guimenu>View</guimenu><guimenuitem>Zoom In</guimenuitem></menuchoice>."
msgstr ""
"ເພື່ອຂະຫຍາຍຂະໜາດຂອງລາຍການໃນມຸມມອງ, ໃຫ້ເລືອກ <menuchoice><guimenu>ວິວ</guimenu>"
"<guimenuitem>ຂະຫຍາຍ</guimenuitem></menuchoice>."

#. (itstool) path: listitem/para
#: C/goscaja.xml:1360
msgid "To reduce the size of items in a view, choose <menuchoice><guimenu>View</guimenu><guimenuitem>Zoom Out</guimenuitem></menuchoice>."
msgstr ""
"ເພື່ອຫຍໍ້ຂະໜາດຂອງລາຍການໃນມຸມມອງ, ໃຫ້ເລືອກ <menuchoice><guimenu>ວິວ</guimenu>"
"<guimenuitem>ຫຍໍ້</guimenuitem></menuchoice>."

#. (itstool) path: listitem/para
#: C/goscaja.xml:1363
msgid "To return items in a view to the normal size, choose <menuchoice><guimenu>View</guimenu><guimenuitem>Normal Size</guimenuitem></menuchoice>."
msgstr ""
"ເພື່ອຄືນຄ່າລາຍການໃນມຸມມອງໃຫ້ເປັນຂະໜາດປົກກະຕີ, ໃຫ້ເລືອກ <menuchoice><guimenu>ວິວ</guimenu>"
"<guimenuitem>ຂະໜາດປົກກະຕິ</guimenuitem></menuchoice>."

#. (itstool) path: section/para
#: C/goscaja.xml:1366
msgid "You can also use the zoom buttons on the location bar in a browser window to change the size of items in a view. <xref linkend=\"goscaja-TBL-42\"/> describes how to use the zoom buttons."
msgstr ""
"ເຈົ້າສາມາດໃຊ້ປຸ່ມຊູມ (zoom) ຢູ່ແຖບຕຳແໜ່ງໃນໜ້າຕ່າງບຣາວເຊີເພື່ອປ່ຽນຂະໜາດຂອງລາຍການໃນມຸມມອງໄດ້. "
"<xref linkend=\"goscaja-TBL-42\"/> ອະທິບາຍວິທີການໃຊ້ປຸ່ມຊູມ."

#. (itstool) path: info/title
#: C/goscaja.xml:1369
msgid "Zoom Buttons"
msgstr "ປຸ່ມຊູມ"

#. (itstool) path: entry/para
#: C/goscaja.xml:1377
msgid "Button"
msgstr "ປຸ່ມ"

#. (itstool) path: entry/para
#: C/goscaja.xml:1380
msgid "Button Name"
msgstr "ຊື່ປຸ່ມ"


#. (itstool) path: section/para
#: C/goscustdesk.xml:212
msgid "The <application>Appearance</application> preference tool lets you configure various aspects of how your desktop looks:"
msgstr ""
"ເຄື່ອງມືການຕັ້ງຄ່າ <application>ຮູບລັກສະນະ</application> ຊ່ວຍໃຫ້ທ່ານສາມາດ ຕັ້ງຄ່າດ້ານຕ່າງໆຂອງ"
"ຮູບລັກສະນະເດັສທັອບຂອງທ່ານ:"

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:216
msgid "Theme,"
msgstr "ທິມ (Theme),"

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:219
msgid "Desktop Background,"
msgstr "ພື້ນຫຼັງເດັສທັອບ,"

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:222
msgid "Fonts,"
msgstr "ຕົວອັກສອນ,"

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:225

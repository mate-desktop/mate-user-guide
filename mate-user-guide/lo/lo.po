#. (itstool) path: info/title
#: C/goscustdesk.xml:229
msgid "Theme Preferences"
msgstr "ການຕັ້ງຄ່າທິມ"

#. (itstool) path: section/indexterm
#: C/goscustdesk.xml:234
msgid "<primary>themes</primary> <secondary>setting controls options</secondary>"
msgstr "<primary>ທິມ</primary> <secondary>ການຕັ້ງຄ່າຕົວຄວບຄຸມ</secondary>"

#. (itstool) path: section/indexterm
#: C/goscustdesk.xml:238
msgid "<primary>themes</primary> <secondary>setting window frame options</secondary>"
msgstr "<primary>ທິມ</primary> <secondary>ການຕັ້ງຄ່າຂອບໜ້າຕ່າງ</secondary>"

#. (itstool) path: section/indexterm
#: C/goscustdesk.xml:242
msgid "<primary>themes</primary> <secondary>setting icons options</secondary>"
msgstr "<primary>ທິມ</primary> <secondary>ການຕັ້ງຄ່າໄອຄອນ</secondary>"

#. (itstool) path: section/indexterm
#: C/goscustdesk.xml:246
msgid "<primary>windows</primary> <secondary>setting frame theme options</secondary>"
msgstr "<primary>ໜ້າຕ່າງ</primary> <secondary>ການຕັ້ງຄ່າທິມຂອບ</secondary>"

#. (itstool) path: section/indexterm
#: C/goscustdesk.xml:250
msgid "<primary>preference tools</primary> <secondary>Theme</secondary>"
msgstr "<primary>ເຄື່ອງມືການຕັ້ງຄ່າ</primary> <secondary>ທິມ</secondary>"

#. (itstool) path: section/para
#: C/goscustdesk.xml:255
msgid "A theme is a group of coordinated settings that specifies the visual appearance of a part of the MATE Desktop. You can choose themes to change the appearance of the MATE Desktop. Use the <application>Theme</application> tabbed section to select a theme. You can choose from a list of available themes. The list of available themes includes several themes for users with accessibility requirements."
msgstr ""
"ທິມແມ່ນກຸ່ມຂອງການຕັ້ງຄ່າທີ່ສອດຄ່ອງກັນ ເຊິ່ງກຳນົດຮູບລັກສະນະຂອງສ່ວນຕ່າງໆໃນ ເດັສທັອບ MATE. ທ່ານສາມາດເ"
"ລືອກທິມເພື່ອປ່ຽນຮູບລັກສະນະຂອງເດັສທັອບ MATE ໄດ້. ໃຫ້ໃຊ້ແທັບ <application>ທິມ</application> ເ"
"ພື່ອເລືອກທິມ. ທ່ານສາມາດເລືອກ ຈາກລາຍຊື່ທິມທີ່ມີຢູ່. ລາຍຊື່ທິມເຫຼົ່ານີ້ລວມມີທິມສຳລັບຜູ້ໃຊ້ທີ່ມີ ຄວາມຕ້ອງການດ້ານກ"
"ານເຂົ້າເຖິງນຳອີກ."

#. (itstool) path: section/para
#: C/goscustdesk.xml:260
msgid "A theme contains settings that affect different parts of the MATE Desktop, as follows:"
msgstr "ທິມຈະລວມມີການຕັ້ງຄ່າທີ່ມີຜົນຕໍ່ສ່ວນຕ່າງໆຂອງເດັສທັອບ MATE ດັ່ງນີ້:"

#. (itstool) path: varlistentry/term
#: C/goscustdesk.xml:263
msgid "Controls"
msgstr "ຕົວຄວບຄຸມ"

#. (itstool) path: para/indexterm
#: C/goscustdesk.xml:265
msgid "<primary>GTK+ themes</primary><see>themes, controls options</see>"
msgstr "<primary>GTK+ themes</primary><see>ທິມ, ຕົວເລືອກຕົວຄວບຄຸມ</see>"

#. (itstool) path: para/indexterm
#: C/goscustdesk.xml:266
msgid "<primary>themes</primary><secondary>controls options</secondary><tertiary>introduction</tertiary>"
msgstr ""
"<primary>ທິມ</primary><secondary>ຕົວເລືອກຕົວຄວບຄຸມ</secondary><tertiary>ບົດນຳ</"
"tertiary>"

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:265
msgid "<_:indexterm-1/><_:indexterm-2/>The controls setting for a theme determines the visual appearance of windows, panels, and applets. The controls setting also determines the visual appearance of the MATE-compliant interface items that appear on windows, panels, and applets, such as menus, icons, and buttons. Some controls setting options that are available are designed for special accessibility needs. You can choose an option for the controls setting from the <guilabel>Controls</guilabel> tabbed section in the <guilabel>Customize Theme</guilabel> window."
msgstr ""
"<_:indexterm-1/><_:indexterm-2/>ການຕັ້ງຄ່າຕົວຄວບຄຸມສຳລັບທິມຈະກຳນົດ ຮູບລັກສະນະຂອງໜ້າຕ່າງ, "
"ແຜງ, ແລະ ແອັບເປລັດ. ການຕັ້ງຄ່າຕົວຄວບຄຸມຍັງກຳນົດ ຮູບລັກສະນະຂອງລາຍການຕ່າງໆທີ່ປາກົດເທິງໜ້າຕ່າງ, ແຜ"
"ງ, ແລະ ແອັບເປລັດ ເຊັ່ນ ເມນູ, ໄອຄອນ, ແລະ ປຸ່ມຕ່າງໆ. ຕົວເລືອກບາງຢ່າງຖືກອອກແບບມາສຳລັບ ຄວາມຕ້ອງ"
"ການດ້ານການເຂົ້າເຖິງພິເສດ. ທ່ານສາມາດເລືອກຕົວຄວບຄຸມໄດ້ຈາກ ແທັບ <guilabel>ຕົວຄວບຄຸມ</"
"guilabel> ໃນໜ້າຕ່າງ <guilabel>ປັບແຕ່ງທິມ</guilabel>."

#. (itstool) path: varlistentry/term
#: C/goscustdesk.xml:276
msgid "Colors"
msgstr "ສີ"

#. (itstool) path: para/indexterm
#: C/goscustdesk.xml:278
msgid "<primary>themes</primary><secondary>color options</secondary><tertiary>introduction</tertiary>"
msgstr ""
"<primary>ທິມ</primary><secondary>ຕົວເລືອກສີ</secondary><tertiary>ບົດນຳ</tertiary>"

#. (itstool) path: para/indexterm
#: C/goscustdesk.xml:278
msgid "<primary>color themes</primary><see>themes, color options</see>"
msgstr "<primary>ທິມສີ</primary><see>ທິມ, ຕົວເລືອກສີ</see>"

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:278
msgid "<_:indexterm-1/><_:indexterm-2/>The color setting for a theme determines the color of various user interface elements. You can choose several pairs of colors from the <guilabel>Colors</guilabel> tabbed section in the <guilabel>Customize Theme</guilabel> window."
msgstr ""
"<_:indexterm-1/><_:indexterm-2/>ການຕັ້ງຄ່າສີສຳລັບທິມຈະກຳນົດສີຂອງ ອົງປະກອບຕ່າງໆໃນໜ້າຕ່າງກາ"
"ນໃຊ້ງານ. ທ່ານສາມາດເລືອກຄູ່ສີຕ່າງໆໄດ້ຈາກ ແທັບ <guilabel>ສີ</guilabel> ໃນໜ້າຕ່າງ <guilabel>"
"ປັບແຕ່ງທິມ</guilabel>."

#. (itstool) path: note/para
#: C/goscustdesk.xml:280
msgid "It is important to choose pairs of colors that have a good contrast with each other, otherwise text may become hard to read."
msgstr ""
"ສິ່ງສຳຄັນແມ່ນຄວນເລືອກຄູ່ສີທີ່ມີຄວາມແຕກຕ່າງ (contrast) ກັນດີ, ຖ້າບໍ່ດັ່ງນັ້ນຂໍ້ຄວາມອາດຈະອ່ານໄດ້ຍາກ."

#. (itstool) path: varlistentry/term
#: C/goscustdesk.xml:285
msgid "Window frame"
msgstr "ຂອບໜ້າຕ່າງ"

#. (itstool) path: para/indexterm
#: C/goscustdesk.xml:287
msgid "<primary>themes</primary><secondary>window frame options</secondary><tertiary>introduction</tertiary>"
msgstr ""
"<primary>ທິມ</primary><secondary>ຕົວເລືອກຂອບໜ້າຕ່າງ</secondary><tertiary>ບົດນຳ</"
"tertiary>"

#. (itstool) path: para/indexterm
#: C/goscustdesk.xml:287
msgid "<primary>Marco themes</primary><see>themes, window frame options</see>"
msgstr "<primary>Marco themes</primary><see>ທິມ, ຕົວເລືອກຂອບໜ້າຕ່າງ</see>"

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:287
msgid "<_:indexterm-1/><_:indexterm-2/>The window frame setting for a theme determines the appearance of the frames around windows only. You can choose an option for the window frame setting from the <guilabel>Window Border</guilabel> tabbed section in the <guilabel>Customize Theme</guilabel> window."
msgstr ""
"<_:indexterm-1/><_:indexterm-2/>ການຕັ້ງຄ່າຂອບໜ້າຕ່າງສຳລັບທິມຈະກຳນົດ ຮູບລັກສະນະຂອງຂອບອ້ອມ"
"ຮອບໜ້າຕ່າງເທົ່ານັ້ນ. ທ່ານສາມາດເລືອກຂອບໜ້າຕ່າງໄດ້ຈາກ ແທັບ <guilabel>ຂອບໜ້າຕ່າງ</guilabel> ໃນ"
"ໜ້າຕ່າງ <guilabel>ປັບແຕ່ງທິມ</guilabel>."

#. (itstool) path: varlistentry/term
#: C/goscustdesk.xml:293
msgid "Icons"
msgstr "ໄອຄອນ"

#. (itstool) path: para/indexterm
#: C/goscustdesk.xml:295
msgid "<primary>themes</primary><secondary>icons options</secondary><tertiary>introduction</tertiary>"
msgstr ""
"<primary>ທິມ</primary><secondary>ຕົວເລືອກໄອຄອນ</secondary><tertiary>ບົດນຳ</"
"tertiary>"

#. (itstool) path: para/indexterm
#: C/goscustdesk.xml:295
msgid "<primary>icon themes</primary><see>themes, icons options</see>"
msgstr "<primary>ທິມໄອຄອນ</primary><see>ທິມ, ຕົວເລືອກໄອຄອນ</see>"

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:295
msgid "<_:indexterm-1/><_:indexterm-2/>The icon setting for a theme determines the appearance of the icons on panels and the desktop background. You can choose an option for the icon setting from the <guilabel>Icons</guilabel> tabbed section in the <guilabel>Customize Theme</guilabel> window."
msgstr ""
"<_:indexterm-1/><_:indexterm-2/>ການຕັ້ງຄ່າໄອຄອນສຳລັບທິມຈະກຳນົດ ຮູບລັກສະນະຂອງໄອຄອນເທິງແ"
"ຜງ ແລະ ພື້ນຫຼັງເດັສທັອບ. ທ່ານສາມາດເລືອກໄອຄອນໄດ້ຈາກ ແທັບ <guilabel>ໄອຄອນ</guilabel> ໃນໜ້າ"
"ຕ່າງ <guilabel>ປັບແຕ່ງທິມ</guilabel>."

#. (itstool) path: varlistentry/term
#: C/goscustdesk.xml:301
msgid "Pointer"
msgstr "ຕົວຊີ້"

#. (itstool) path: para/indexterm
#: C/goscustdesk.xml:303
msgid "<primary>themes</primary><secondary>pointer options</secondary><tertiary>introduction</tertiary>"
msgstr ""
"<primary>ທິມ</primary><secondary>ຕົວເລືອກຕົວຊີ້</secondary><tertiary>ບົດນຳ</"
"tertiary>"

#. (itstool) path: para/indexterm
#: C/goscustdesk.xml:303
msgid "<primary>pointer themes</primary><see>themes, pointer options</see>"
msgstr "<primary>ທິມຕົວຊີ້</primary><see>ທິມ, ຕົວເລືອກຕົວຊີ້</see>"

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:303
msgid "<_:indexterm-1/><_:indexterm-2/>The pointer setting for a theme determines the appearance of and size of the mouse pointer. You can choose the options for setting the pointer from the <guilabel>Pointer</guilabel> tabbed section in the <guilabel>Customize Theme</guilabel> window."
msgstr ""
"<_:indexterm-1/><_:indexterm-2/>ການຕັ້ງຄ່າຕົວຊີ້ສຳລັບທິມຈະກຳນົດ ຮູບລັກສະນະ ແລະ ຂະໜາດຂອງຕົ"
"ວຊີ້ເມົາສ໌. ທ່ານສາມາດເລືອກຕົວຊີ້ໄດ້ຈາກ ແທັບ <guilabel>ຕົວຊີ້</guilabel> ໃນໜ້າຕ່າງ <guilabel>ປັ"
"ບແຕ່ງທິມ</guilabel>."

#. (itstool) path: info/title
#: C/goscustdesk.xml:308
msgid "To Create a Custom Theme"
msgstr "ວິທີສ້າງທິມທີ່ກຳນົດເອງ"

#. (itstool) path: section/para
#: C/goscustdesk.xml:310
msgid "The themes that are listed in the <guilabel>Theme</guilabel> tabbed section are different combinations of controls options, window frame options, and icon options. You can create a custom theme that uses different combinations of controls options, window frame options, and icon options."
msgstr ""
"ທິມທີ່ສະແດງໃນແທັບ <guilabel>ທິມ</guilabel> ແມ່ນການລວມກັນຂອງຕົວເລືອກ ຕົວຄວບຄຸມ, ຂອບໜ້າຕ່າ"
"ງ, ແລະ ໄອຄອນທີ່ແຕກຕ່າງກັນ. ທ່ານສາມາດສ້າງທິມໃໝ່ ໂດຍການເລືອກປະສົມປະສານຕົວເລືອກເຫຼົ່ານັ້ນຕາມຄວາມຕ້"
"ອງການ."

#. (itstool) path: section/para
#: C/goscustdesk.xml:314
msgid "To create a custom theme, perform the following steps:"
msgstr "ເພື່ອສ້າງທິມທີ່ກຳນົດເອງ, ໃຫ້ປະຕິບັດຕາມຂັ້ນຕອນດັ່ງນີ້:"

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:317
#: C/goscustdesk.xml:367
#: C/goscustdesk.xml:428
msgid "Start the <application>Appearance</application> preference tool. Open the <guilabel>Theme</guilabel> tabbed section."
msgstr ""
"ເປີດເຄື່ອງມືການຕັ້ງຄ່າ <application>ຮູບລັກສະນະ</application>. ເປີດ ແທັບ <guilabel>ທິມ</"
"guilabel>."

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:321
msgid "Select a theme in the list of themes."
msgstr "ເລືອກທິມໜຶ່ງຈາກລາຍຊື່ທິມ."

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:324
#: C/goscustdesk.xml:432
msgid "Click on the <guibutton>Customize</guibutton> button. A <guilabel>Customize Theme</guilabel> dialog is displayed."
msgstr ""
"ຄລິກໃສ່ປຸ່ມ <guibutton>ປັບແຕ່ງ</guibutton>. ໜ້າຕ່າງໂຕ້ຕອບ <guilabel>ປັບແຕ່ງທິມ</"
"guilabel> ຈະສະແດງຂຶ້ນ."

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:327
msgid "Select the controls option that you want to use in the custom theme from the list in the <guilabel>Controls</guilabel> tabbed section. The list of available controls options includes several options for users with accessibility requirements."
msgstr ""
"ເລືອກຕົວຄວບຄຸມທີ່ທ່ານຕ້ອງການໃຊ້ໃນທິມໃໝ່ຈາກລາຍຊື່ໃນແທັບ <guilabel>ຕົວຄວບຄຸມ</guilabel>. ລາຍຊື່ນີ້"
"ຈະລວມມີຕົວເລືອກສຳລັບ ຄວາມຕ້ອງການດ້ານການເຂົ້າເຖິງນຳອີກ."

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:333
msgid "Click on the <guilabel>Window Border</guilabel> tab to display the <guilabel>Window Border</guilabel> tabbed section. Select the window frame option that you want to use in the custom theme from the list of available options. The list of available window frame options includes several options for users with accessibility requirements."
msgstr ""
"ຄລິກໃສ່ແທັບ <guilabel>ຂອບໜ້າຕ່າງ</guilabel> ເພື່ອເບິ່ງຕົວເລືອກຂອບໜ້າຕ່າງ. ເລືອກຂອບໜ້າຕ່າງທີ່ທ່ານ"
"ຕ້ອງການໃຊ້ຈາກລາຍຊື່ທີ່ມີຢູ່."

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:340
msgid "Click on the <guilabel>Icons</guilabel> tab to display the <guilabel>Icons</guilabel> tabbed section. Select the icons option that you want to use in the custom theme from the list of available options. The list of available icons options includes several options for users with accessibility requirements."
msgstr ""
"ຄລິກໃສ່ແທັບ <guilabel>ໄອຄອນ</guilabel> ເພື່ອເບິ່ງຕົວເລືອກໄອຄອນ. ເລືອກໄອຄອນທີ່ທ່ານຕ້ອງການໃຊ້ຈ"
"າກລາຍຊື່ທີ່ມີຢູ່."

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:345
msgid "Click <guibutton>Close</guibutton> to close the <guilabel>Customize Theme</guilabel> dialog."
msgstr ""
"ຄລິກ <guibutton>ປິດ</guibutton> ເພື່ອປິດໜ້າຕ່າງໂຕ້ຕອບ <guilabel>ປັບແຕ່ງທິມ</guilabel>."

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:348
msgid "On the <application>Appearance</application> preferences tool, click on the <guibutton>Save As</guibutton> button. A <guilabel>Save Theme As</guilabel> dialog is displayed."
msgstr ""
"ໃນເຄື່ອງມືການຕັ້ງຄ່າ <application>ຮູບລັກສະນະ</application>, ຄລິກໃສ່ປຸ່ມ <guibutton>ບັນທຶກເປັ"
"ນ</guibutton>. ໜ້າຕ່າງ <guilabel>ບັນທຶກທິມເປັນ</guilabel> ຈະສະແດງຂຶ້ນ."

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:353
msgid "Type a name and a short description for the custom theme in the dialog, then click <guibutton>Save</guibutton>. The custom theme now appears in your list of available themes."
msgstr ""
"ພິມຊື່ ແລະ ຄຳອະທິບາຍສັ້ນໆສຳລັບທິມໃໝ່, ຈາກນັ້ນຄລິກ <guibutton>ບັນທຶກ</guibutton>. ຕອນນີ້ທິມໃໝ່ຈະ"
"ປາກົດໃນລາຍຊື່ທິມຂອງທ່ານ."

#. (itstool) path: info/title
#: C/goscustdesk.xml:360
msgid "To Install a New Theme"
msgstr "ວິທີຕິດຕັ້ງທິມໃໝ່"

#. (itstool) path: section/para
#: C/goscustdesk.xml:361
msgid "You can add a theme to the list of available themes. The new theme must be an archive file that is tarred and zipped. That is, the new theme must be a <filename>.tar.gz</filename> file."
msgstr ""
"ທ່ານສາມາດເພີ່ມທິມໃໝ່ລົງໃນລາຍຊື່ທິມທີ່ມີຢູ່ໄດ້. ທິມໃໝ່ຕ້ອງເປັນໄຟລ໌ ທີ່ຖືກບີບອັດໃນຮູບແບບ <filename>"
".tar.gz</filename>."

#. (itstool) path: section/para
#: C/goscustdesk.xml:364
msgid "To install a new theme, perform the following steps:"
msgstr "ເພື່ອຕິດຕັ້ງທິມໃໝ່, ໃຫ້ປະຕິບັດຕາມຂັ້ນຕອນດັ່ງນີ້:"

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:371
msgid "Click on the <guibutton>Install</guibutton> button. A file chooser dialog is displayed."
msgstr ""
"ຄລິກໃສ່ປຸ່ມ <guibutton>ຕິດຕັ້ງ</guibutton>. ໜ້າຕ່າງເລືອກໄຟລ໌ຈະສະແດງຂຶ້ນ."

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:375
msgid "Enter the location of the theme archive file in the location entry. Alternatively, select the theme archive file in the file list. When you have selected the file, click <guibutton>Open</guibutton>."
msgstr ""
"ລະບຸຕຳແໜ່ງຂອງໄຟລ໌ທິມ ຫຼື ເລືອກໄຟລ໌ທິມຈາກລາຍຊື່ໄຟລ໌. ເມື່ອເລືອກໄຟລ໌ແລ້ວ, ໃຫ້ຄລິກ <guibutton>ເປີດ</"
"guibutton>."

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:379
msgid "Click on the <guibutton>Install</guibutton> button to install the new theme."
msgstr "ຄລິກໃສ່ປຸ່ມ <guibutton>ຕິດຕັ້ງ</guibutton> ເພື່ອຕິດຕັ້ງທິມໃໝ່."

#. (itstool) path: info/title
#: C/goscustdesk.xml:422
msgid "To Delete a Theme Option"
msgstr "ວິທີລຶບຕົວເລືອກທິມ"

#. (itstool) path: section/para
#: C/goscustdesk.xml:423
msgid "You can delete controls options, window frame options, or icons options."
msgstr "ທ່ານສາມາດລຶບຕົວເລືອກຕົວຄວບຄຸມ, ຂອບໜ້າຕ່າງ, ຫຼື ໄອຄອນໄດ້."

#. (itstool) path: section/para
#: C/goscustdesk.xml:424
msgid "To delete a controls option, window frame option, or icons option, perform the following steps:"
msgstr "ເພື່ອລຶບຕົວເລືອກເຫຼົ່ານັ້ນ, ໃຫ້ປະຕິບັດຕາມຂັ້ນຕອນດັ່ງນີ້:"

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:436
msgid "Click on the tab for the type of option that you want to delete."
msgstr "ຄລິກໃສ່ແທັບຂອງປະເພດຕົວເລືອກທີ່ທ່ານຕ້ອງການລຶບ."

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:439
msgid "Select the theme option you want to delete."
msgstr "ເລືອກຕົວເລືອກທິມທີ່ທ່ານຕ້ອງການລຶບ."

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:442
msgid "Use the <guibutton>Delete</guibutton> button to delete the selected option. Note that you can not delete system-wide theme options."
msgstr ""
"ໃຊ້ປຸ່ມ <guibutton>ລຶບ</guibutton> ເພື່ອລຶບຕົວເລືອກທີ່ເລືອກໄວ້. ໝາຍເຫດ: ທ່ານບໍ່ສາມາດລຶບທິມທີ່ມີມາກັ"
"ບລະບົບໄດ້."

#. (itstool) path: info/title
#: C/goscustdesk.xml:450
#: C/goscustdesk.xml:489
msgid "Desktop Background Preferences"
msgstr "ການຕັ້ງຄ່າພື້ນຫຼັງເດັສທັອບ"

#. (itstool) path: section/indexterm
#: C/goscustdesk.xml:453
msgid "<primary>desktop</primary> <secondary>customizing background</secondary>"
msgstr "<primary>ເດັສທັອບ</primary> <secondary>ການປັບແຕ່ງພື້ນຫຼັງ</secondary>"

#. (itstool) path: section/indexterm
#: C/goscustdesk.xml:457
msgid "<primary>MATE Desktop preference tools</primary> <see>preference tools</see>"
msgstr ""
"<primary>ເຄື່ອງມືການຕັ້ງຄ່າເດັສທັອບ MATE</primary> <see>ເຄື່ອງມືການຕັ້ງຄ່າ</see>"

#. (itstool) path: section/indexterm
#: C/goscustdesk.xml:461
msgid "<primary>preference tools</primary> <secondary>Background</secondary>"
msgstr "<primary>ເຄື່ອງມືການຕັ້ງຄ່າ</primary> <secondary>ພື້ນຫຼັງ</secondary>"

#. (itstool) path: section/indexterm
#: C/goscustdesk.xml:465
msgid "<primary>backgrounds</primary> <secondary>customizing desktop background</secondary>"
msgstr ""
"<primary>ພື້ນຫຼັງ</primary> <secondary>ການປັບແຕ່ງພື້ນຫຼັງເດັສທັອບ</secondary>"

#. (itstool) path: section/para
#: C/goscustdesk.xml:469
msgid "The <xref linkend=\"overview-desktop\"/> background is the image or color that is applied to your desktop. You can open <guilabel>Background</guilabel> tabbed section in the <application>Appearance</application> preference tool by right-clicking on the desktop and choosing <guimenuitem>Change Desktop Background</guimenuitem>, as well as from the <menuchoice><guimenu>System</guimenu><guisubmenu>Preferences</guisubmenu></menuchoice> menu."
msgstr ""
"ພື້ນຫຼັງ <xref linkend=\"overview-desktop\"/> ແມ່ນຮູບພາບ ຫຼື ສີທີ່ໃຊ້ກັບ ເດັສທັອບຂອງທ່ານ. ທ່ານ"
"ສາມາດເປີດແທັບ <guilabel>ພື້ນຫຼັງ</guilabel> ໃນເຄື່ອງມື <application>ຮູບລັກສະນະ</"
"application> ໄດ້ໂດຍການຄລິກຂວາໃສ່ເດັສທັອບ ແລ້ວເລືອກ <guimenuitem>ປ່ຽນພື້ນຫຼັງເດັສທັອບ</"
"guimenuitem>, ຫຼື ໄປທີ່ເມນູ <menuchoice><guimenu>ລະບົບ</guimenu><guisubmenu>ການຕັ້ງຄ່"
"າ</guisubmenu></menuchoice>."

#. (itstool) path: section/para
#: C/goscustdesk.xml:471
msgid "You can customize the desktop background in the following ways:"
msgstr "ທ່ານສາມາດປັບແຕ່ງພື້ນຫຼັງເດັສທັອບໄດ້ດ້ວຍວິທີດັ່ງນີ້:"

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:474
msgid "Select an image for the desktop background. The image is superimposed on the desktop background color. The desktop background color is visible if you select a transparent image, or if the image does not cover the entire desktop."
msgstr ""
"ເລືອກຮູບພາບສຳລັບພື້ນຫຼັງເດັສທັອບ. ຮູບພາບຈະຖືກວາງທັບເທິງສີພື້ນຫຼັງ. ສີພື້ນຫຼັງຈະເບິ່ງເຫັນໄດ້ຫາກທ່ານເລືອກຮູບພ"
"າບທີ່ມີຄວາມໂປ່ງໃສ, ຫຼື ຫາກຮູບພາບນັ້ນບໍ່ເຕັມໜ້າຈໍເດັສທັອບ."

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:480
msgid "Select a color for the desktop background. You can select a solid color, or create a gradient effect with two colors. A gradient effect is a visual effect where one color blends gradually into another color."
msgstr ""
"ເລືອກສີສຳລັບພື້ນຫຼັງເດັສທັອບ. ທ່ານສາມາດເລືອກສີດຽວ (solid color), ຫຼື ສ້າງເອັບເຟັກການໄລ່ສີ "
"(gradient) ດ້ວຍສອງສີ. ການໄລ່ສີແມ່ນເອັບເຟັກ ທີ່ສີໜຶ່ງຈະຄ່ອຍໆກືນເຂົ້າໄປຫາອີກສີໜຶ່ງ."

#. (itstool) path: tip/para
#: C/goscustdesk.xml:485
msgid "You can also drag a color or a pattern to the desktop from the <guilabel>Backgrounds and Emblems</guilabel> dialog in the <application>Caja</application> file manager (see <xref linkend=\"caja-backgrounds-and-emblems\"/>)."
msgstr ""
"ທ່ານຍັງສາມາດລາກສີ ຫຼື ລວດລາຍໃສ່ເດັສທັອບໄດ້ຈາກໜ້າຕ່າງ <guilabel>ພື້ນຫຼັງ ແລະ ເຄື່ອງໝາຍ</"
"guilabel> ໃນຕົວຈັດການໄຟລ໌ <application>Caja</application> (ເບິ່ງ <xref "
"linkend=\"caja-backgrounds-and-emblems\"/>)."

#. (itstool) path: section/para
#: C/goscustdesk.xml:487
msgid "<xref linkend=\"goscustdesk-TBL-14\"/> lists the background preferences that you can modify."
msgstr ""
"<xref linkend=\"goscustdesk-TBL-14\"/> ສະແດງລາຍຊື່ການຕັ້ງຄ່າພື້ນຫຼັງ ທີ່ທ່ານສາມາດແກ້ໄຂໄດ້."

#. (itstool) path: entry/para
#: C/goscustdesk.xml:506
msgid "<guibutton>Desktop Background</guibutton>"
msgstr "<guibutton>ພື້ນຫຼັງເດັສທັອບ</guibutton>"

#. (itstool) path: entry/para
#: C/goscustdesk.xml:511
msgid "Choose an image from the list. Alternately, you can use the <guibutton>Add</guibutton> button to choose any image on your computer."
msgstr ""
"ເລືອກຮູບພາບຈາກລາຍຊື່. ຫຼື ທ່ານສາມາດໃຊ້ປຸ່ມ <guibutton>ເພີ່ມ</guibutton> ເພື່ອເລືອກຮູບພາບໃດໜຶ່ງໃ"
"ນຄອມພິວເຕີຂອງທ່ານ."

#. (itstool) path: entry/para
#: C/goscustdesk.xml:517
msgid "<guilabel>Style</guilabel>"
msgstr "<guilabel>ຮູບແບບ</guilabel>"

#. (itstool) path: entry/para
#: C/goscustdesk.xml:522
msgid "To specify how to display the image, select one of the following options from the <guilabel>Style</guilabel> drop-down list:"
msgstr ""
"ເພື່ອລະບຸວິທີການສະແດງຮູບພາບ, ໃຫ້ເລືອກຕົວເລືອກໃດໜຶ່ງຈາກລາຍຊື່ <guilabel>ຮູບແບບ</guilabel> ດັ່ງ"
"ນີ້:"

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:526
msgid "<guilabel>Centered</guilabel>: Displays the image in the middle of the desktop, respecting the image's original size."
msgstr ""
"<guilabel>ໄວ້ກາງ</guilabel>: ສະແດງຮູບພາບຢູ່ເຄິ່ງກາງເດັສທັອບ, ໂດຍໃຊ້ຂະໜາດເດີມຂອງຮູບພາບ."

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:530
msgid "<guilabel>Fill Screen</guilabel>: Enlarges the image to cover the desktop, altering its proportions if needed."
msgstr ""
"<guilabel>ເຕັມໜ້າຈໍ</guilabel>: ຂະຫຍາຍຮູບພາບໃຫ້ເຕັມເດັສທັອບ, ເຊິ່ງອາດຈະເຮັດໃຫ້ສັດສ່ວນຂອງຮູບປ່"
"ຽນແປງ."

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:534
msgid "<guilabel>Scaled</guilabel>: Enlarges the image until the image meets the screen edges, and maintains the proportions of the image."
msgstr ""
"<guilabel>ປັບຂະໜາດ</guilabel>: ຂະຫຍາຍຮູບພາບຈົນກວ່າຈະຮອດຂອບໜ້າຈໍ, ໂດຍຮັກສາສັດສ່ວນຂອງຮູບພ"
"າບໄວ້."

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:538
msgid "<guilabel>Zoom</guilabel>: Enlarges the smaller dimension of the image until it meets the screen edges; the image may be cropped in the other dimension."
msgstr ""
"<guilabel>ຊູມ</guilabel>: ຂະຫຍາຍດ້ານທີ່ນ້ອຍກວ່າຂອງຮູບພາບຈົນກວ່າຈະຮອດຂອບໜ້າຈໍ; ຮູບພາບອາດຈະ"
"ຖືກຕັດອອກໃນບາງສ່ວນ."

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:542
msgid "<guilabel>Tiled</guilabel>: Duplicates the original-sized image as often as necessary and print the images next to another so as they entirely cover the desktop."
msgstr ""
"<guilabel>ລຽງຕໍ່ກັນ</guilabel>: ເຮັດຊໍ້າຮູບພາບຂະໜາດເດີມຕໍ່ໆກັນ ຈົນກວ່າຈະເຕັມໜ້າຈໍເດັສທັອບ."

#. (itstool) path: entry/para
#: C/goscustdesk.xml:550
msgid "<guilabel>Add</guilabel>"
msgstr "<guilabel>ເພີ່ມ</guilabel>"

#. (itstool) path: entry/para
#: C/goscustdesk.xml:556
msgid "Click on the <guibutton>Add</guibutton> to browse for an image on your computer. A standard file selector will be presented. Choose the image you want and click <guibutton>Open</guibutton>."
msgstr ""
"ຄລິກໃສ່ປຸ່ມ <guibutton>ເພີ່ມ</guibutton> ເພື່ອຊອກຫາຮູບພາບໃນຄອມພິວເຕີຂອງທ່ານ. ເລືອກຮູບພາບທີ່ທ່າ"
"ນຕ້ອງການແລ້ວຄລິກ <guibutton>ເປີດ</guibutton>."

#. (itstool) path: entry/para
#: C/goscustdesk.xml:563
msgid "<guilabel>Remove</guilabel>"
msgstr "<guilabel>ລຶບອອກ</guilabel>"

#. (itstool) path: entry/para
#: C/goscustdesk.xml:568
msgid "Choose the image that you want to remove, then click <guilabel>Remove</guilabel>. This removes the image from the list of available wallpapers; however, it does not delete the image from your computer."
msgstr ""
"ເລືອກຮູບພາບທີ່ທ່ານຕ້ອງການລຶບອອກ, ຈາກນັ້ນຄລິກ <guilabel>ລຶບອອກ</guilabel>. ສິ່ງນີ້ຈະລຶບຮູບພາບອອ"
"ກຈາກລາຍຊື່ວໍເປເປີເທົ່ານັ້ນ, ແຕ່ບໍ່ໄດ້ລຶບໄຟລ໌ຮູບ ອອກຈາກຄອມພິວເຕີຂອງທ່ານ."

#. (itstool) path: entry/para
#: C/goscustdesk.xml:574
msgid "<guilabel>Colors</guilabel>"
msgstr "<guilabel>ສີ</guilabel>"

#. (itstool) path: entry/para
#: C/goscustdesk.xml:579
msgid "To specify a color scheme, use the options in the <guilabel>Style</guilabel> drop-down list, and the color selector buttons."
msgstr ""
"ເພື່ອລະບຸຮູບແບບສີ, ໃຫ້ໃຊ້ຕົວເລືອກໃນລາຍຊື່ <guilabel>ຮູບແບບ</guilabel> ແລະ ປຸ່ມເລືອກສີ."

#. (itstool) path: entry/para
#: C/goscustdesk.xml:582
msgid "You can specify a color scheme in one of the following ways:"
msgstr "ທ່ານສາມາດລະບຸຮູບແບບສີໄດ້ດ້ວຍວິທີໃດໜຶ່ງດັ່ງນີ້:"

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:586
msgid "Choose <guilabel>Solid color</guilabel> from the <guilabel>Background Style</guilabel> drop-down list to specify a single color for the desktop background."
msgstr ""
"ເລືອກ <guilabel>ສີດຽວ</guilabel> ຈາກລາຍຊື່ <guilabel>ຮູບແບບພື້ນຫຼັງ</guilabel> ເພື່ອໃຊ້ສີດ"
"ຽວສຳລັບພື້ນຫຼັງເດັສທັອບ."

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:588
msgid "To choose the color that you require, click on the <guibutton>Color</guibutton> button. The <guilabel>Pick a Color</guilabel> dialog is displayed. Choose a color, then click <guibutton>OK</guibutton>."
msgstr ""
"ເພື່ອເລືອກສີທີ່ຕ້ອງການ, ຄລິກໃສ່ປຸ່ມ <guibutton>ສີ</guibutton>. ໜ້າຕ່າງ <guilabel>ເລືອກສີ</"
"guilabel> ຈະສະແດງຂຶ້ນ. ເລືອກສີແລ້ວຄລິກ <guibutton>ຕົກລົງ</guibutton>."

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:592
msgid "Choose <guilabel>Horizontal gradient</guilabel> from the <guilabel>Background Style</guilabel> drop-down list. This option creates a gradient effect from the left screen edge to the right screen edge."
msgstr ""
"ເລືອກ <guilabel>ການໄລ່ສີຕາມລວງນອນ</guilabel> ຈາກລາຍຊື່ <guilabel>ຮູບແບບພື້ນຫຼັງ</"
"guilabel>. ຕົວເລືອກນີ້ຈະສ້າງການໄລ່ສີຈາກຂອບຊ້າຍຫາຂອບຂວາ."

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:594
msgid "Click on the <guibutton>Left Color</guibutton> button to display the <guilabel>Pick a Color</guilabel> dialog. Choose the color that you want to appear at the left edge."
msgstr ""
"ຄລິກໃສ່ປຸ່ມ <guibutton>ສີເບື້ອງຊ້າຍ</guibutton> ເພື່ອເລືອກສີ ທີ່ຕ້ອງການໃຫ້ປາກົດຢູ່ຂອບເບື້ອງຊ້າຍ."

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:596
msgid "Click on the <guibutton>Right Color</guibutton> button. Choose the color that you want to appear at the right edge."
msgstr ""
"ຄລິກໃສ່ປຸ່ມ <guibutton>ສີເບື້ອງຂວາ</guibutton> ເພື່ອເລືອກສີ ທີ່ຕ້ອງການໃຫ້ປາກົດຢູ່ຂອບເບື້ອງຂວາ."

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:600
msgid "Choose <guilabel>Vertical gradient</guilabel> from the <guilabel>Background Style</guilabel> drop-down list. This creates a gradient effect from the top screen edge to the bottom screen edge."
msgstr ""
"ເລືອກ <guilabel>ການໄລ່ສີຕາມລວງຕັ້ງ</guilabel> ຈາກລາຍຊື່ <guilabel>ຮູບແບບພື້ນຫຼັງ</"
"guilabel>. ສິ່ງນີ້ຈະສ້າງການໄລ່ສີຈາກຂອບເທິງຫາຂອບລຸ່ມ."

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:602
msgid "Click on the <guibutton>Top Color</guibutton> button to display the <guilabel>Pick a Color</guilabel> dialog. Choose the color that you want to appear at the top edge."
msgstr ""
"ຄລິກໃສ່ປຸ່ມ <guibutton>ສີເບື້ອງເທິງ</guibutton> ເພື່ອເລືອກສີ ທີ່ຕ້ອງການໃຫ້ປາກົດຢູ່ຂອບເບື້ອງເທິງ."

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:604
msgid "Click on the <guibutton>Bottom Color</guibutton> button. Choose the color that you want to appear at the bottom edge."
msgstr ""
"ຄລິກໃສ່ປຸ່ມ <guibutton>ສີເບື້ອງລຸ່ມ</guibutton> ເພື່ອເລືອກສີ ທີ່ຕ້ອງການໃຫ້ປາກົດຢູ່ຂອບເບື້ອງລຸ່ມ."

#. (itstool) path: info/title
#: C/goscustdesk.xml:615
msgid "Font Preferences"
msgstr "ການຕັ້ງຄ່າຕົວອັກສອນ"

#. (itstool) path: section/indexterm
#: C/goscustdesk.xml:620
msgid "<primary>preference tools</primary> <secondary>Font</secondary>"
msgstr "<primary>ເຄື່ອງມືການຕັ້ງຄ່າ</primary> <secondary>ຕົວອັກສອນ</secondary>"

#. (itstool) path: section/indexterm
#: C/goscustdesk.xml:624
msgid "<primary>fonts</primary> <secondary>desktop</secondary>"
msgstr "<primary>ຕົວອັກສອນ</primary> <secondary>ເດັສທັອບ</secondary>"

#. (itstool) path: section/indexterm
#: C/goscustdesk.xml:628
msgid "<primary>fonts</primary> <secondary>applications</secondary>"
msgstr "<primary>ຕົວອັກສອນ</primary> <secondary>ແອັບພລິເຄຊັນ</secondary>"

#. (itstool) path: section/indexterm
#: C/goscustdesk.xml:632
msgid "<primary>fonts</primary> <secondary>window title</secondary>"
msgstr "<primary>ຕົວອັກສອນ</primary> <secondary>ຫົວຂໍ້ໜ້າຕ່າງ</secondary>"

#. (itstool) path: section/indexterm
#: C/goscustdesk.xml:636
msgid "<primary>fonts</primary> <secondary>terminal</secondary>"
msgstr "<primary>ຕົວອັກສອນ</primary> <secondary>ເທິມິນອລ</secondary>"

#. (itstool) path: section/indexterm
#: C/goscustdesk.xml:640
msgid "<primary>fonts</primary> <secondary>rendering</secondary>"
msgstr "<primary>ຕົວອັກສອນ</primary> <secondary>ການສະແດງຜົນ</secondary>"

#. (itstool) path: section/para
#: C/goscustdesk.xml:644
msgid "Use the <guilabel>Fonts</guilabel> tabbed section in the <application>Appearance</application> preference tool to choose which fonts are used in different parts of the desktop, and the way in which fonts are displayed on the screen."
msgstr ""
"ໃຊ້ແທັບ <guilabel>ຕົວອັກສອນ</guilabel> ໃນເຄື່ອງມື <application>ຮູບລັກສະນະ</"
"application> ເພື່ອເລືອກຕົວອັກສອນທີ່ຈະໃຊ້ໃນສ່ວນຕ່າງໆຂອງເດັສທັອບ, ແລະ ວິທີການສະແດງຜົນ ຂອງຕົວອັກສ"
"ອນເທິງໜ້າຈໍ."

#. (itstool) path: info/title
#: C/goscustdesk.xml:647
msgid "Choosing Fonts"
msgstr "ການເລືອກຕົວອັກສອນ"

#. (itstool) path: section/para
#: C/goscustdesk.xml:648
msgid "The font selector button shows the name of the font and its point size. The name is also shown in bold, italic, or regular type."
msgstr ""
"ປຸ່ມເລືອກຕົວອັກສອນຈະສະແດງຊື່ຂອງຕົວອັກສອນ ແລະ ຂະໜາດຂອງມັນ. ຊື່ຈະສະແດງເປັນຕົວໜາ, ຕົວເນີ້ງ, ຫຼື ຕົວປົ"
"ກກະຕິ."

#. (itstool) path: section/para
#: C/goscustdesk.xml:649
msgid "To change the font, click the font selector button. The font picker dialog opens. Select the font family, style, and point size from the lists. The preview area shows your current choice. Click <guibutton>OK</guibutton> to accept the change and update the desktop."
msgstr ""
"ເພື່ອປ່ຽນຕົວອັກສອນ, ຄລິກໃສ່ປຸ່ມເລືອກຕົວອັກສອນ. ໜ້າຕ່າງເລືອກຕົວອັກສອນຈະເປີດຂຶ້ນ. ເລືອກຕະກຸນຕົວອັກສອນ, "
"ຮູບແບບ, ແລະ ຂະໜາດຈາກລາຍຊື່. ພື້ນທີ່ຕົວຢ່າງ ຈະສະແດງຜົນທີ່ທ່ານເລືອກ. ຄລິກ <guibutton>ຕົກລົງ</"
"guibutton> ເພື່ອຍອມຮັບການປ່ຽນແປງ."

#. (itstool) path: section/para
#: C/goscustdesk.xml:650
msgid "You can choose fonts for the following parts of the desktop:"
msgstr "ທ່ານສາມາດເລືອກຕົວອັກສອນສຳລັບສ່ວນຕ່າງໆຂອງເດັສທັອບດັ່ງນີ້:"

#. (itstool) path: varlistentry/term
#: C/goscustdesk.xml:654
msgid "<guilabel>Application font</guilabel>"
msgstr "<guilabel>ຕົວອັກສອນແອັບພລິເຄຊັນ</guilabel>"

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:656
msgid "This font is used in the menus, toolbars, and dialog boxes of applications."
msgstr ""
"ຕົວອັກສອນນີ້ຖືກໃຊ້ໃນເມນູ, ແຖບເຄື່ອງມື, ແລະ ໜ້າຕ່າງໂຕ້ຕອບຂອງແອັບພລິເຄຊັນ."

#. (itstool) path: varlistentry/term
#: C/goscustdesk.xml:660
msgid "<guilabel>Document font</guilabel>"
msgstr "<guilabel>ຕົວອັກສອນເອກະສານ</guilabel>"

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:662
msgid "This font is used to display documents in applications."
msgstr "ຕົວອັກສອນນີ້ຖືກໃຊ້ເພື່ອສະແດງເອກະສານໃນແອັບພລິເຄຊັນ."

#. (itstool) path: note/para
#: C/goscustdesk.xml:663
msgid "In some applications, you can override this choice in the application's preferences dialog."
msgstr ""
"ໃນບາງແອັບພລິເຄຊັນ, ທ່ານສາມາດຕັ້ງຄ່າແຍກຕ່າງຫາກໃນໜ້າຕ່າງການຕັ້ງຄ່າ ຂອງແອັບພລິເຄຊັນນັ້ນໆໄດ້."

#. (itstool) path: varlistentry/term
#: C/goscustdesk.xml:667
msgid "<guilabel>Desktop font</guilabel>"
msgstr "<guilabel>ຕົວອັກສອນເດັສທັອບ</guilabel>"

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:669
msgid "This font is used in icon labels on the desktop."
msgstr "ຕົວອັກສອນນີ້ຖືກໃຊ້ໃນຊື່ໄອຄອນເທິງເດັສທັອບ."

#. (itstool) path: varlistentry/term
#: C/goscustdesk.xml:673
msgid "<guilabel>Window title font</guilabel>"
msgstr "<guilabel>ຕົວອັກສອນຫົວຂໍ້ໜ້າຕ່າງ</guilabel>"

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:675
msgid "This font is used in the titlebars of windows."
msgstr "ຕົວອັກສອນນີ້ຖືກໃຊ້ໃນແຖບຫົວຂໍ້ຂອງໜ້າຕ່າງ."

#. (itstool) path: varlistentry/term
#: C/goscustdesk.xml:679
msgid "<guilabel>Fixed width font</guilabel>"
msgstr "<guilabel>ຕົວອັກສອນຄວາມກວ້າງຄົງທີ່</guilabel>"

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:681
msgid "This font is used in the <application>Terminal</application> application and applications to do with programming."
msgstr ""
"ຕົວອັກສອນນີ້ຖືກໃຊ້ໃນແອັບພລິເຄຊັນ <application>ເທິມິນອລ</application> ແລະ ແອັບພລິເຄຊັນທີ່ກ່ຽວກັບ"
"ການຂຽນໂປຣແກຣມ."

#. (itstool) path: info/title
#: C/goscustdesk.xml:687
msgid "Font Rendering"
msgstr "ການສະແດງຜົນຕົວອັກສອນ"

#. (itstool) path: section/para
#: C/goscustdesk.xml:688
msgid "You can set the following options relating to how fonts are displayed on the screen:"
msgstr "ທ່ານສາມາດຕັ້ງຄ່າວິທີການສະແດງຜົນຕົວອັກສອນເທິງໜ້າຈໍໄດ້ດັ່ງນີ້:"

#. (itstool) path: varlistentry/term
#: C/goscustdesk.xml:692
msgid "<guilabel>Rendering</guilabel>"
msgstr "<guilabel>ການສະແດງຜົນ</guilabel>"

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:694
msgid "To specify how to render fonts on your screen, select one of the following options:"
msgstr ""
"ເພື່ອລະບຸວິທີການສະແດງຜົນຕົວອັກສອນເທິງໜ້າຈໍ, ໃຫ້ເລືອກຕົວເລືອກໃດໜຶ່ງດັ່ງນີ້:"

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:698
msgid "<guilabel>Monochrome</guilabel>: Renders fonts in black and white only. The edges of characters might appear jagged in some cases because the characters are not antialiased. <firstterm>Antialiasing</firstterm> is an effect that is applied to the edges of characters to make the characters look smoother."
msgstr ""
"<guilabel>ຂາວດຳ</guilabel>: ສະແດງຕົວອັກສອນເປັນສີຂາວ ແລະ ດຳເທົ່ານັ້ນ. ຂອບຂອງຕົວອັກສອນອາດ"
"ຈະເຫັນເປັນຮອຍຢັກ ເພາະບໍ່ໄດ້ໃຊ້ການລົບຮອຍຢັກ (antialiasing). <firstterm>ການລົບຮອຍຢັກ</"
"firstterm> ແມ່ນເອັບເຟັກທີ່ໃຊ້ກັບຂອບຕົວອັກສອນ ເພື່ອໃຫ້ເບິ່ງລຽບນຽນຂຶ້ນ."

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:705
msgid "<guilabel>Best shapes</guilabel>: Antialiases fonts where possible. Use this option for standard Cathode Ray Tube (CRT) monitors."
msgstr ""
"<guilabel>ຮູບຮ່າງທີ່ດີທີ່ສຸດ</guilabel>: ລົບຮອຍຢັກຕົວອັກສອນໃນບ່ອນທີ່ເຮັດໄດ້. ໃຊ້ຕົວເລືອກນີ້ສຳລັບຈໍພາບ"
"ແບບ CRT ມາດຕະຖານ."

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:709
msgid "<guilabel>Best contrast</guilabel>: Adjusts fonts to give the sharpest possible contrast, and also antialiases fonts, so that characters have smooth edges. This option might enhance the accessibility of the MATE Desktop to users with visual impairments."
msgstr ""
"<guilabel>ຄວາມຄົມຊັດທີ່ດີທີ່ສຸດ</guilabel>: ປັບຕົວອັກສອນໃຫ້ມີຄວາມຄົມຊັດສູງສຸດ, ແລະ ລົບຮອຍຢັກເພື່ອໃ"
"ຫ້ຂອບລຽບນຽນ. ຕົວເລືອກນີ້ຊ່ວຍໃຫ້ຜູ້ທີ່ມີ ບັນຫາດ້ານການເບິ່ງເຫັນສາມາດອ່ານໄດ້ງ່າຍຂຶ້ນ."

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:715
msgid "<guilabel>Subpixel smoothing (LCDs)</guilabel>: Uses techniques that exploit the shape of individual Liquid Crystal Display (LCD) pixels to render fonts smoothly. Use this option for LCD or flat-screen displays."
msgstr ""
"<guilabel>ການປັບລຽບລະດັບຊັບພິກເຊວ (LCD)</guilabel>: ໃຊ້ເຕັກນິກທີ່ເໝາະສົມ ກັບຮູບຮ່າງຂອງພິກເຊ"
"ວໃນຈໍ LCD ເພື່ອໃຫ້ຕົວອັກສອນລຽບນຽນ. ໃຊ້ຕົວເລືອກນີ້ ສຳລັບຈໍ LCD ຫຼື ຈໍແບນ."

#. (itstool) path: varlistentry/term
#: C/goscustdesk.xml:723
msgid "<guibutton>Details</guibutton>"
msgstr "<guibutton>ລາຍລະອຽດ</guibutton>"

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:725
msgid "Click on this button to specify further details of how to render fonts on your screen."
msgstr "ຄລິກໃສ່ປຸ່ມນີ້ເພື່ອລະບຸລາຍລະອຽດເພີ່ມເຕີມໃນການສະແດງຜົນຕົວອັກສອນ."

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:729
msgid "<guilabel>Resolution (dots per inch)</guilabel>: Use the spin box to specify the resolution to use when your screen renders fonts."
msgstr ""
"<guilabel>ຄວາມລະອຽດ (DPI)</guilabel>: ໃຊ້ປຸ່ມປັບຕົວເລກເພື່ອລະບຸ ຄວາມລະອຽດໃນການສະແດງຜົນ"
"ຕົວອັກສອນ."

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:733
msgid "<guilabel>Smoothing</guilabel>: Select one of the options to specify how to antialias fonts."
msgstr ""
"<guilabel>ການເຮັດໃຫ້ລຽບ</guilabel>: ເລືອກຕົວເລືອກໃດໜຶ່ງເພື່ອລະບຸ ວິທີການລົບຮອຍຢັກ."

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:737
msgid "<guilabel>Hinting</guilabel>: <firstterm>Hinting</firstterm> is a font-rendering technique that improves the quality of fonts at small sizes and an at low screen resolutions. Select one of the options to specify how to apply hinting your fonts."
msgstr ""
"<guilabel>ການປັບຊັດ (Hinting)</guilabel>: <firstterm>Hinting</firstterm> ແມ່ນເຕັກ"
"ນິກ ທີ່ຊ່ວຍປັບປຸງຄຸນນະພາບຕົວອັກສອນຂະໜາດນ້ອຍ ຫຼື ໃນຈໍທີ່ມີຄວາມລະອຽດຕໍ່າ."

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:743
msgid "<guilabel>Subpixel order</guilabel>: Select one of the options to specify the subpixel color order for your fonts. Use this option for LCD or flat-screen displays."
msgstr ""
"<guilabel>ລຳດັບຊັບພິກເຊວ</guilabel>: ເລືອກລຳດັບສີຂອງຊັບພິກເຊວ ສຳລັບຕົວອັກສອນຂອງທ່ານ. ໃຊ້ສຳ"
"ລັບຈໍ LCD ຫຼື ຈໍແບນ."

#. (itstool) path: info/title
#: C/goscustdesk.xml:800
msgid "Interface Preferences"
msgstr "ການຕັ້ງຄ່າໜ້າຕ່າງການໃຊ້ງານ"

#. (itstool) path: section/indexterm
#: C/goscustdesk.xml:803
msgid "<primary>toolbars, customizing appearance</primary>"
msgstr "<primary>ແຖບເຄື່ອງມື, ການປັບແຕ່ງຮູບລັກສະນະ</primary>"

#. (itstool) path: section/indexterm
#: C/goscustdesk.xml:806
msgid "<primary>preference tools</primary> <secondary>Menus &amp; Toolbars</secondary>"
msgstr ""
"<primary>ເຄື່ອງມືການຕັ້ງຄ່າ</primary> <secondary>ເມນູ ແລະ ແຖບເຄື່ອງມື</secondary>"

#. (itstool) path: section/indexterm
#: C/goscustdesk.xml:810
msgid "<primary>menus</primary> <secondary>in applications, customizing appearance</secondary>"
msgstr ""
"<primary>ເມນູ</primary> <secondary>ໃນແອັບພລິເຄຊັນ, ການປັບແຕ່ງຮູບລັກສະນະ</secondary>"

#. (itstool) path: section/para
#: C/goscustdesk.xml:814
msgid "You can use the <guilabel>Interface</guilabel> tabbed section in the <application>Appearance</application> preference tool to customize the appearance of menus, menubars, and toolbars for applications that are part of MATE."
msgstr ""
"ທ່ານສາມາດໃຊ້ພາກສ່ວນແທັບ <guilabel>ສ່ວນຕິດຕໍ່ຜູ້ໃຊ້</guilabel> ໃນເຄື່ອງມືປັບແຕ່ງ <application>"
"ຮູບລັກສະນະ</application> ເພື່ອປັບແຕ່ງຮູບລັກສະນະຂອງເມນູ, ແຖບເມນູ ແລະ ແຖບເຄື່ອງມື ສຳລັບແອັບພລິເ"
"ຄຊັນທີ່ເປັນສ່ວນໜຶ່ງຂອງ MATE."

#. (itstool) path: section/para
#: C/goscustdesk.xml:816
msgid "As you make changes to the settings, the preview display in the window updates. This allows you to see the changes if no application windows are currently open."
msgstr ""
"ເມື່ອທ່ານປ່ຽນແປງການຕັ້ງຄ່າ, ການສະແດງຕົວຢ່າງໃນໜ້າຕ່າງຈະຖືກອັບເດດ. ອັນນີ້ຊ່ວຍໃຫ້ທ່ານເຫັນການປ່ຽນແປງໄ"
"ດ້ ເຖິງວ່າຈະບໍ່ມີໜ້າຕ່າງແອັບພລິເຄຊັນໃດເປີດຢູ່ກໍຕາມ."

#. (itstool) path: varlistentry/term
#: C/goscustdesk.xml:819
msgid "<guilabel>Show icons in menus</guilabel>"
msgstr "<guilabel>ສະແດງໄອຄອນໃນເມນູ</guilabel>"

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:821
msgid "Select this option to display an icon beside items in application menus and the panel menu. Not all menu items have an icon."
msgstr ""
"ເລືອກຕົວເລືອກນີ້ເພື່ອສະແດງໄອຄອນໄວ້ຂ້າງລາຍການຕ່າງໆໃນເມນູແອັບພລິເຄຊັນ ແລະ ເມນູແຜງຄວບຄຸມ. ບໍ່ແມ່ນທຸກ"
"ລາຍການເມນູທີ່ຈະມີໄອຄອນ."

#. (itstool) path: varlistentry/term
#: C/goscustdesk.xml:826
msgid "<guilabel>Editable menu shortcut keys</guilabel>"
msgstr "<guilabel>ປຸ່ມທາງລັດເມນູທີ່ແກ້ໄຂໄດ້</guilabel>"

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:827
msgid "Selecting this option allows you to define new keyboard shortcuts for menu items."
msgstr ""
"ການເລືອກຕົວເລືອກນີ້ຈະຊ່ວຍໃຫ້ທ່ານສາມາດກຳນົດປຸ່ມທາງລັດແປ້ນພິມໃໝ່ສຳລັບລາຍການເມນູໄດ້."

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:828
msgid "To change an application shortcut key, open the menu, and with the mouse pointer on the menu item you wish to change, press the new combination of keys. To remove a shortcut key, press <keycap>Backspace</keycap> or <keycap>Delete</keycap>."
msgstr ""
"ເພື່ອປ່ຽນປຸ່ມທາງລັດຂອງແອັບພລິເຄຊັນ, ໃຫ້ເປີດເມນູ, ແລ້ວວາງຕົວຊີ້ເມົ້າໄວ້ເທິງລາຍການເມນູທີ່ທ່ານຕ້ອງການປ່ຽ"
"ນ, ຈາກນັ້ນກົດປຸ່ມປະສົມໃໝ່. ເພື່ອລຶບປຸ່ມທາງລັດ, ໃຫ້ກົດ <keycap>Backspace</keycap> ຫຼື <keycap>"
"Delete</keycap>."

#. (itstool) path: warning/para
#: C/goscustdesk.xml:830
msgid "When using this feature, you will not be warned if assigning a new shortcut key to a command also removes it from another command."
msgstr ""
"ເມື່ອໃຊ້ຄຸນສົມບັດນີ້, ທ່ານຈະບໍ່ໄດ້ຮັບການແຈ້ງເຕືອນ ຫາກການກຳນົດປຸ່ມທາງລັດໃໝ່ໃຫ້ກັບຄຳສັ່ງໃດໜຶ່ງ ໄປທັບຊ້ອນ ແລ"
"ະ ລຶບປຸ່ມທາງລັດອອກຈາກອີກຄຳສັ່ງໜຶ່ງ."

#. (itstool) path: warning/para
#: C/goscustdesk.xml:831
msgid "There is no way to restore the original, default keyboard shortcut for a command."
msgstr ""
"ບໍ່ມີວິທີໃດທີ່ຈະກູ້ຄືນປຸ່ມທາງລັດແປ້ນພິມມາດຕະຖານດັ້ງເດີມສຳລັບຄຳສັ່ງນັ້ນໆໄດ້."

#. (itstool) path: warning/para
#: C/goscustdesk.xml:832
msgid "This feature does not maintain shortcuts that are normally common to all applications, such as <keycombo><keycap>Ctrl</keycap><keycap>C</keycap></keycombo> for Copy. This may lead to inconsistencies in your MATE applications."
msgstr ""
"ຄຸນສົມບັດນີ້ບໍ່ໄດ້ຮັກສາປຸ່ມທາງລັດທີ່ໃຊ້ທົ່ວໄປໃນທຸກແອັບພລິເຄຊັນ, ເຊັ່ນ <keycombo><keycap>Ctrl</"
"keycap><keycap>C</keycap></keycombo> ສຳລັບການສຳເນົາ. ອັນນີ້ອາດຈະເຮັດໃຫ້ເກີດຄວາມບໍ່ສອດຄ່ອ"
"ງກັນໃນແອັບພລິເຄຊັນ MATE ຂອງທ່ານ."

#. (itstool) path: varlistentry/term
#: C/goscustdesk.xml:837
msgid "<guilabel>Toolbar button labels</guilabel>"
msgstr "<guilabel>ປ້າຍຊື່ປຸ່ມແຖບເຄື່ອງມື</guilabel>"

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:839
msgid "Choose one of the following options to specify what to display on the toolbars in your MATE-compliant applications:"
msgstr ""
"ເລືອກໜຶ່ງໃນຕົວເລືອກຕໍ່ໄປນີ້ເພື່ອລະບຸສິ່ງທີ່ຈະສະແດງໃນແຖບເຄື່ອງມືຂອງແອັບພລິເຄຊັນທີ່ຮອງຮັບ MATE ຂອງທ່ານ:"

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:843
msgid "<guilabel>Text Below Icons</guilabel>: Select this option to display toolbars with text as well as an icon on each button."
msgstr ""
"<guilabel>ຂໍ້ຄວາມຢູ່ລຸ່ມໄອຄອນ</guilabel>: ເລືອກຕົວເລືອກນີ້ເພື່ອສະແດງແຖບເຄື່ອງມືທີ່ມີທັງຂໍ້ຄວາມ ແລະ "
"ໄອຄອນໃນແຕ່ລະປຸ່ມ."

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:847
msgid "<guilabel>Text Beside Icons</guilabel>: Select this option to display toolbars with an icon only on each button, and with text on the most important buttons."
msgstr ""
"<guilabel>ຂໍ້ຄວາມຢູ່ຂ້າງໄອຄອນ</guilabel>: ເລືອກຕົວເລືອກນີ້ເພື່ອສະແດງແຖບເຄື່ອງມືທີ່ມີພຽງໄອຄອນໃນແ"
"ຕ່ລະປຸ່ມ, ແລະ ມີຂໍ້ຄວາມສະເພາະປຸ່ມທີ່ສຳຄັນທີ່ສຸດ."

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:852
msgid "<guilabel>Icons Only</guilabel>: Select this option to display toolbars with an icon only on each button."
msgstr ""
"<guilabel>ສະເພາະໄອຄອນ</guilabel>: ເລືອກຕົວເລືອກນີ້ເພື່ອສະແດງແຖບເຄື່ອງມືທີ່ມີພຽງໄອຄອນໃນແຕ່ລະ"
"ປຸ່ມ."

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:856
msgid "<guilabel>Text Only</guilabel>: Select this option to display toolbars with text only on each button."
msgstr ""
"<guilabel>ສະເພາະຂໍ້ຄວາມ</guilabel>: ເລືອກຕົວເລືອກນີ້ເພື່ອສະແດງແຖບເຄື່ອງມືທີ່ມີພຽງຂໍ້ຄວາມໃນແຕ່ລະ"
"ປຸ່ມ."

#. (itstool) path: info/title
#: C/goscustdesk.xml:866
#: C/goscustdesk.xml:882
msgid "Windows Preferences"
msgstr "ການຕັ້ງຄ່າໜ້າຕ່າງ"

#. (itstool) path: section/indexterm
#: C/goscustdesk.xml:870
msgid "<primary>window manager</primary> <secondary>customizing</secondary>"
msgstr "<primary>ຕົວຈັດການໜ້າຕ່າງ</primary> <secondary>ການປັບແຕ່ງ</secondary>"

#. (itstool) path: section/indexterm
#: C/goscustdesk.xml:874
msgid "<primary>preference tools</primary> <secondary>Windows</secondary>"
msgstr "<primary>ເຄື່ອງມືປັບແຕ່ງ</primary> <secondary>ໜ້າຕ່າງ</secondary>"

#. (itstool) path: section/para
#: C/goscustdesk.xml:878
msgid "Use the <application>Windows</application> preference tool to customize window behavior for the MATE Desktop."
msgstr ""
"ໃຊ້ເຄື່ອງມືປັບແຕ່ງ <application>ໜ້າຕ່າງ</application> ເພື່ອປັບແຕ່ງພຶດຕິກຳຂອງໜ້າຕ່າງສຳລັບເດັສທັອ"
"ບ MATE."

#. (itstool) path: section/para
#: C/goscustdesk.xml:880
msgid "<xref linkend=\"goscustwindows-TBL-14\"/> lists the windows preferences that you can modify."
msgstr ""
"<xref linkend=\"goscustwindows-TBL-14\"/> ສະແດງລາຍການການຕັ້ງຄ່າໜ້າຕ່າງທີ່ທ່ານສາມາດແກ້ໄ"
"ຂໄດ້."

#. (itstool) path: entry/para
#: C/goscustdesk.xml:899
msgid "<guilabel>Select windows when the mouse moves over them</guilabel>"
msgstr "<guilabel>ເລືອກໜ້າຕ່າງເມື່ອເມົ້າເລື່ອນຜ່ານ</guilabel>"

#. (itstool) path: entry/para
#: C/goscustdesk.xml:904
msgid "Select this option to give focus to a window when you point to the window. The window retains focus until you point to another window."
msgstr ""
"ເລືອກຕົວເລືອກນີ້ເພື່ອໃຫ້ຈຸດສົນໃຈ (focus) ໄປທີ່ໜ້າຕ່າງເມື່ອທ່ານຊີ້ໄປໃສ່. ໜ້າຕ່າງຈະຮັກສາຈຸດສົນໃຈນັ້ນໄວ້ຈົນກວ່"
"າທ່ານຈະຊີ້ໄປໃສ່ໜ້າຕ່າງອື່ນ."

#. (itstool) path: entry/para
#: C/goscustdesk.xml:911
msgid "<guilabel>Raise selected windows after an interval</guilabel>"
msgstr "<guilabel>ຍົກໜ້າຕ່າງທີ່ເລືອກຂຶ້ນຫຼັງຈາກໄລຍະເວລາໃດໜຶ່ງ</guilabel>"

#. (itstool) path: entry/para
#: C/goscustdesk.xml:916
msgid "Select this option to raise windows a short time after the window receives focus."
msgstr ""
"ເລືອກຕົວເລືອກນີ້ເພື່ອຍົກໜ້າຕ່າງຂຶ້ນມາທາງໜ້າ ຫຼັງຈາກທີ່ໜ້າຕ່າງນັ້ນໄດ້ຮັບຈຸດສົນໃຈແລ້ວໄລຍະໜຶ່ງ."

#. (itstool) path: entry/para
#: C/goscustdesk.xml:922
msgid "<guilabel>Interval before raising</guilabel>"
msgstr "<guilabel>ໄລຍະເວລາກ່ອນຈະຍົກຂຶ້ນ</guilabel>"

#. (itstool) path: entry/para
#: C/goscustdesk.xml:927
msgid "Specify the interval to wait before raising a window that has received focus."
msgstr "ລະບຸໄລຍະເວລາທີ່ຈະລໍຖ້າ ກ່ອນຈະຍົກໜ້າຕ່າງທີ່ໄດ້ຮັບຈຸດສົນໃຈແລ້ວຂຶ້ນມາ."

#. (itstool) path: entry/para
#: C/goscustdesk.xml:933
msgid "<guilabel>Double-click titlebar to perform this action</guilabel>"
msgstr "<guilabel>ດັບເບິນຄລິກທີ່ແຖບຊື່ເພື່ອດຳເນີນການນີ້</guilabel>"

#. (itstool) path: entry/para
#: C/goscustdesk.xml:938
msgid "Select the behavior that you want to occur when you double-click on a window titlebar. Select one of the following options:"
msgstr ""
"ເລືອກພຶດຕິກຳທີ່ທ່ານຕ້ອງການໃຫ້ເກີດຂຶ້ນເມື່ອທ່ານດັບເບິນຄລິກໃສ່ແຖບຊື່ຂອງໜ້າຕ່າງ. ເລືອກໜຶ່ງໃນຕົວເລືອກຕໍ່ໄປນີ້:"

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:943
msgid "<guilabel>Maximize</guilabel>: Maximizes the window."
msgstr "<guilabel>ຂະຫຍາຍໃຫຍ່ສຸດ</guilabel>: ຂະຫຍາຍໜ້າຕ່າງໃຫ້ເຕັມຈໍ."

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:946
msgid "<guilabel>Maximize Vertically</guilabel>: Maximizes the window vertically without changing its width."
msgstr ""
"<guilabel>ຂະຫຍາຍໃຫຍ່ສຸດຕາມທາງຕັ້ງ</guilabel>: ຂະຫຍາຍໜ້າຕ່າງຕາມທາງຕັ້ງໂດຍບໍ່ປ່ຽນແປງຄວາມກວ້"
"າງ."

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:949
msgid "<guilabel>Maximize Horizontally</guilabel>: Maximizes the window horizontally without changing its height."
msgstr ""
"<guilabel>ຂະຫຍາຍໃຫຍ່ສຸດຕາມທາງຂວາງ</guilabel>: ຂະຫຍາຍໜ້າຕ່າງຕາມທາງຂວາງໂດຍບໍ່ປ່ຽນແປງຄວ"
"າມສູງ."

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:952
msgid "<guilabel>Minimize</guilabel>: Minimizes the window."
msgstr "<guilabel>ຫຍໍ້ລົງນ້ອຍສຸດ</guilabel>: ຫຍໍ້ໜ້າຕ່າງລົງ."

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:955
msgid "<guilabel>Roll up</guilabel>: Roll up the window."
msgstr "<guilabel>ມ້ວນຂຶ້ນ</guilabel>: ມ້ວນໜ້າຕ່າງຂຶ້ນໃຫ້ເຫຼືອແຕ່ແຖບຊື່."

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:958
msgid "<guilabel>None</guilabel>: Do nothing."
msgstr "<guilabel>ບໍ່ມີ</guilabel>: ບໍ່ຕ້ອງເຮັດຫຍັງ."

#. (itstool) path: entry/para
#: C/goscustdesk.xml:961
msgid "If a window is already maximized or rolled up, double-clicking on the titlebar will return it to its normal state."
msgstr ""
"ຫາກໜ້າຕ່າງຖືກຂະຫຍາຍໃຫຍ່ສຸດ ຫຼື ມ້ວນຂຶ້ນຢູ່ແລ້ວ, ການດັບເບິນຄລິກທີ່ແຖບຊື່ຈະສົ່ງມັນກັບຄືນສູ່ສະພາບປົກກະຕິ."

#. (itstool) path: entry/para
#: C/goscustdesk.xml:967
msgid "<guilabel>To move a window, press-and-hold this key then grab the window</guilabel>"
msgstr ""
"<guilabel>ເພື່ອຍ້າຍໜ້າຕ່າງ, ໃຫ້ກົດປຸ່ມນີ້ຄ້າງໄວ້ແລ້ວຈັບໜ້າຕ່າງ</guilabel>"

#. (itstool) path: entry/para
#: C/goscustdesk.xml:972
msgid "Select the key to press-and-hold when you drag a window to move the window."
msgstr "ເລືອກປຸ່ມທີ່ຈະກົດຄ້າງໄວ້ເມື່ອທ່ານລາກໜ້າຕ່າງເພື່ອຍ້າຍໜ້າຕ່າງ."

#. (itstool) path: note/para
#: C/goscustdesk.xml:980
msgid "The position of the Control, Alt and Super keys on the keyboard can be modified in the Keyboard Layout Options dialog, see <xref linkend=\"prefs-keyboard-layoutoptions\"/>."
msgstr ""
"ຕຳແໜ່ງຂອງປຸ່ມ Control, Alt ແລະ Super ເທິງແປ້ນພິມສາມາດປ່ຽນແປງໄດ້ໃນກ່ອງຂໍ້ຄວາມຕົວເລືອກຮູບແບບແ"
"ປ້ນພິມ, ເບິ່ງ <xref linkend=\"prefs-keyboard-layoutoptions\"/>."

#. (itstool) path: info/title
#: C/goscustdesk.xml:986
msgid "Screensaver Preferences"
msgstr "ການຕັ້ງຄ່າຕົວຮັກສາໜ້າຈໍ"

#. (itstool) path: section/indexterm
#: C/goscustdesk.xml:987
msgid "<primary>preference tools</primary> <secondary>screensaver</secondary>"
msgstr "<primary>ເຄື່ອງມືປັບແຕ່ງ</primary> <secondary>ຕົວຮັກສາໜ້າຈໍ</secondary>"

#. (itstool) path: section/para
#: C/goscustdesk.xml:991
msgid "A <firstterm>screensaver</firstterm> displays moving images on your screen when your computer is not being used. Screensavers also help prevent older monitors being damaged by the same image being displayed for long periods of time. To stop the screensaver and return to the desktop, move the mouse or press a key on the keyboard."
msgstr ""
"<firstterm>ຕົວຮັກສາໜ້າຈໍ</firstterm> ຈະສະແດງພາບເຄື່ອນໄຫວໃນໜ້າຈໍຂອງທ່ານເມື່ອບໍ່ມີການໃຊ້ງານຄອມ"
"ພິວເຕີ. ຕົວຮັກສາໜ້າຈໍຍັງຊ່ວຍປ້ອງກັນບໍ່ໃຫ້ຈໍພາບລຸ້ນເກົ່າເສຍຫາຍຈາກການສະແດງພາບເດີມຄ້າງໄວ້ເປັນເວລານານ. "
"ເພື່ອຢຸດຕົວຮັກສາໜ້າຈໍ ແລະ ກັບຄືນສູ່ເດັສທັອບ, ໃຫ້ເລື່ອນເມົ້າ ຫຼື ກົດປຸ່ມໃດໜຶ່ງເທິງແປ້ນພິມ."

#. (itstool) path: section/para
#: C/goscustdesk.xml:992
msgid "Use the <application>Screensaver</application> preference tool to set the type of screensaver, the time before the screensaver starts, and whether to require a password to return to the desktop."
msgstr ""
"ໃຊ້ເຄື່ອງມືປັບແຕ່ງ <application>ຕົວຮັກສາໜ້າຈໍ</application> ເພື່ອຕັ້ງຄ່າປະເພດຂອງຕົວຮັກສາໜ້າຈໍ, ໄ"
"ລຍະເວລາກ່ອນຈະເລີ່ມເຮັດງານ, ແລະ ກຳນົດວ່າຕ້ອງໃຊ້ລະຫັດຜ່ານເພື່ອກັບຄືນສູ່ເດັສທັອບຫຼືບໍ່."

#. (itstool) path: section/para
#: C/goscustdesk.xml:993
msgid "You can modify the following settings:"
msgstr "ທ່ານສາມາດແກ້ໄຂການຕັ້ງຄ່າຕໍ່ໄປນີ້:"

#. (itstool) path: varlistentry/term
#: C/goscustdesk.xml:996
msgid "Screensaver"
msgstr "ຕົວຮັກສາໜ້າຈໍ"

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:997
msgid "Select the <guilabel>Screensaver theme</guilabel> from the list. A reduced version of the selected screensaver theme is shown. Press <guibutton>Preview</guibutton> to show the selected theme on the whole screen. During preview, use the arrow buttons at the top of the screen to go through the list of screensaver themes."
msgstr ""
"ເລືອກ <guilabel>ທີມຕົວຮັກສາໜ້າຈໍ</guilabel> ຈາກລາຍການ. ລະບົບຈະສະແດງຕົວຢ່າງທີມທີ່ເລືອກໃນຂະໜ"
"າດນ້ອຍ. ກົດ <guibutton>ສະແດງຕົວຢ່າງ</guibutton> ເພື່ອເບິ່ງທີມທີ່ເລືອກແບບເຕັມຈໍ. ໃນລະຫວ່າງການ"
"ສະແດງຕົວຢ່າງ, ສາມາດໃຊ້ປຸ່ມລູກສອນຢູ່ສ່ວນເທິງຂອງໜ້າຈໍເພື່ອເລື່ອນເບິ່ງລາຍການທີມອື່ນໆ."

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:999
msgid "The <guilabel>Blank screen</guilabel> theme displays no image and only shows a black screen."
msgstr ""
"ທີມ <guilabel>ໜ້າຈໍຫວ່າງເປົ່າ</guilabel> ຈະບໍ່ສະແດງຮູບພາບໃດໆ ແລະ ຈະສະແດງພຽງແຕ່ໜ້າຈໍສີດຳ."

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:1000
msgid "The <guilabel>Random</guilabel> theme selects a screensaver to display from the list at random."
msgstr ""
"ທີມ <guilabel>ສຸ່ມ</guilabel> ຈະເລືອກຕົວຮັກສາໜ້າຈໍຈາກລາຍການມາສະແດງແບບສຸ່ມ."

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:1002
msgid "Which screensavers are shown in the remainder of the list depends on your distributor or vendor."
msgstr ""
"ຕົວຮັກສາໜ້າຈໍອື່ນໆທີ່ປະກົດໃນລາຍການແມ່ນຂຶ້ນກັບຜູ້ແຈກຢາຍ ຫຼື ຜູ້ຜະລິດລະບົບຂອງທ່ານ."

#. (itstool) path: varlistentry/term
#: C/goscustdesk.xml:1005
msgid "Regard the computer as idle after..."
msgstr "ຖືວ່າຄອມພິວເຕີບໍ່ມີການໃຊ້ງານຫຼັງຈາກ..."

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:1006
msgid "Your computer becomes idle after this amount of time has passed with no input from you, such as moving the mouse or typing. This may affect power management (the monitor may power down for example) or instant messaging (chat applications may set your status as \"away\"). Use the slider to set the length of time in minutes or hours."
msgstr ""
"ຄອມພິວເຕີຂອງທ່ານຈະຖືວ່າບໍ່ມີການໃຊ້ງານ ຫຼັງຈາກຜ່ານໄລຍະເວລານີ້ໄປໂດຍບໍ່ມີການປ້ອນຂໍ້ມູນຈາກທ່ານ ເຊັ່ນ: ການ"
"ເລື່ອນເມົ້າ ຫຼື ການພິມ. ອັນນີ້ອາດຈະສົ່ງຜົນຕໍ່ການຈັດການພະລັງງານ (ເຊັ່ນ: ຈໍພາບອາດຈະປິດລົງ) ຫຼື ແອັບແຊັດ "
"(ອາດຈະປ່ຽນສະຖານະຂອງທ່ານເປັນ \"ບໍ່ຢູ່\"). ໃຊ້ແຖບເລື່ອນເພື່ອຕັ້ງເວລາເປັນນາທີ ຫຼື ຊົ່ວໂມງ."

#. (itstool) path: varlistentry/term
#: C/goscustdesk.xml:1009
msgid "Activate screensaver when computer is idle"
msgstr "ເປີດໃຊ້ຕົວຮັກສາໜ້າຈໍເມື່ອຄອມພິວເຕີບໍ່ມີການໃຊ້ງານ"

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:1010
msgid "Select this option to have the screensaver start after the set length of time."
msgstr ""
"ເລືອກຕົວເລືອກນີ້ເພື່ອໃຫ້ຕົວຮັກສາໜ້າຈໍເລີ່ມເຮັດງານ ຫຼັງຈາກຜ່ານໄລຍະເວລາທີ່ກຳນົດໄວ້."

#. (itstool) path: varlistentry/term
#: C/goscustdesk.xml:1013
msgid "Lock screen when screensaver is active"
msgstr "ລັອກໜ້າຈໍເມື່ອຕົວຮັກສາໜ້າຈໍເຮັດງານ"

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:1014
msgid "When this option is selected, the screensaver will prompt you for your password when you try to return to the desktop. For more on locking your screen, see <xref linkend=\"lock-screen\"/>."
msgstr ""
"ເມື່ອເລືອກຕົວເລືອກນີ້, ຕົວຮັກສາໜ້າຈໍຈະຖາມລະຫັດຜ່ານເມື່ອທ່ານພະຍາຍາມກັບຄືນສູ່ເດັສທັອບ. ສຶກສາເພີ່ມເຕີມກ່ຽວກັ"
"ບການລັອກໜ້າຈໍໄດ້ທີ່ <xref linkend=\"lock-screen\"/>."

#. (itstool) path: info/title
#: C/goscustdesk.xml:1020
msgid "Internet and Network"
msgstr "ອິນເຕີເນັດ ແລະ ເຄືອຂ່າຍ"

#. (itstool) path: info/title
#: C/goscustdesk.xml:1022
msgid "Network Settings"
msgstr "ການຕັ້ງຄ່າເຄືອຂ່າຍ"

#. (itstool) path: section/para
#: C/goscustdesk.xml:1023
msgid "The <application>Network Settings</application> allows you to specify the way your system connects to other computers and to internet."
msgstr ""
"<application>ການຕັ້ງຄ່າເຄືອຂ່າຍ</application> ຊ່ວຍໃຫ້ທ່ານສາມາດລະບຸວິທີທີ່ລະບົບຂອງທ່ານເຊື່ອມຕໍ່ກັບ"
"ຄອມພິວເຕີອື່ນໆ ແລະ ອິນເຕີເນັດ."

#. (itstool) path: section/para
#: C/goscustdesk.xml:1024
msgid "You will be prompted for the administrator password when you start <application>Network Settings</application>. This is because the changes done with this tool will affect the whole system."
msgstr ""
"ທ່ານຈະຖືກຖາມລະຫັດຜ່ານຂອງຜູ້ດູແລລະບົບເມື່ອເລີ່ມໃຊ້ <application>ການຕັ້ງຄ່າເຄືອຂ່າຍ</application>"
". ເນື່ອງຈາກການປ່ຽນແປງທີ່ເຮັດດ້ວຍເຄື່ອງມືນີ້ຈະສົ່ງຜົນກະທົບຕໍ່ທັງລະບົບ."

#. (itstool) path: info/title
#: C/goscustdesk.xml:1026
msgid "Getting started"
msgstr "ການເລີ່ມຕົ້ນໃຊ້ງານ"

#. (itstool) path: section/para
#: C/goscustdesk.xml:1027
msgid "The <application>Network Settings</application> main window contains four tabbed sections:"
msgstr ""
"ໜ້າຕ່າງຫຼັກຂອງ <application>ການຕັ້ງຄ່າເຄືອຂ່າຍ</application> ປະກອບມີ 4 ພາກສ່ວນແທັບ:"

#. (itstool) path: varlistentry/term
#: C/goscustdesk.xml:1030
msgid "<guilabel>Connections</guilabel>"
msgstr "<guilabel>ການເຊື່ອມຕໍ່</guilabel>"

#. (itstool) path: listitem/para
#: C/goscustdesk.xml:1032
msgid "Shows all network interfaces, it also allows you to modify their settings."
msgstr ""
"ສະແດງອິນເຕີເຟສເຄືອຂ່າຍທັງໝົດ, ແລະ ຊ່ວຍໃຫ້ທ່ານແກ້ໄຂການຕັ້ງຄ່າຂອງພວກມັນໄດ້."

#. (itstool) path: varlistentry/term
#: C/goscustdesk.xml:1037

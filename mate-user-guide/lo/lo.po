#. (itstool) path: entry/para
#: C/goscaja.xml:3655
#: C/goscaja.xml:3828
msgid "<guilabel>Permissions</guilabel>"
msgstr "<guilabel>ການອະນຸຍາດ</guilabel>"

#. (itstool) path: para/indexterm
#: C/goscaja.xml:3660
#: C/goscaja.xml:3833
msgid "<primary>permissions</primary><secondary>displaying as characters</secondary>"
msgstr ""
"<primary>ການອະນຸຍາດ</primary><secondary>ການສະແດງຜົນເປັນຕົວອັກສອນ</secondary>"

#. (itstool) path: entry/para
#: C/goscaja.xml:3660
#: C/goscaja.xml:3833
msgid "<_:indexterm-1/>Choose this option to display the permissions of the item as three sets of three characters, for example <computeroutput>-rwxrw-r--</computeroutput>."
msgstr ""
"<_:indexterm-1/>ເລືອກຕົວເລືອກນີ້ເພື່ອສະແດງການອະນຸຍາດຂອງລາຍການເປັນສາມຊຸດ ຊຸດລະສາມຕົວອັກສອ"
"ນ, ຕົວຢ່າງ <computeroutput>-rwxrw-r--</computeroutput>."

#. (itstool) path: entry/para
#: C/goscaja.xml:3667
#: C/goscaja.xml:3807
msgid "<guilabel>Octal Permissions</guilabel>"
msgstr "<guilabel>ການອະນຸຍາດແບບເລກຖານແປດ</guilabel>"

#. (itstool) path: para/indexterm
#: C/goscaja.xml:3672
#: C/goscaja.xml:3812
msgid "<primary>permissions</primary><secondary>displaying in octal notation</secondary>"
